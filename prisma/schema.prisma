// Issuance state of a project/site document link (drawing register semantics).
enum OrgDocumentLinkStatus {
  DRAFT
  ISSUED
  FOR_CONSTRUCTION
  SUPERSEDED
  VOID
}

// External authority approval / registration categories. RERA and friends are
