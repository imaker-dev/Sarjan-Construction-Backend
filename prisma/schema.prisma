}

// Company-owned configurable department, scoped to COMPANY / PROJECT / SITE
// (HEAD_OFFICE scope is rejected). Scope-column consistency is enforced by the
// Department_scope_check CHECK constraint in the migration; tenant integrity by
// the composite FKs below.
model Department {
  id               String             @id @default(uuid()) @db.Uuid
  companyId        String             @db.Uuid
  scopeType        ScopeType
  projectId        String?            @db.Uuid
  siteId           String?            @db.Uuid
  code             String // normalized, unique within the company
  name             String
  capabilityKey    String? // INTERNAL routing id — derived by the service, not user-entered
  category         DepartmentCategory @default(CUSTOM)
  categoryLabel    String? // required when category=CUSTOM
  headEmployeeId   String?            @db.Uuid
  // Physical location only — never a permission scope. Finance/Admin live at
  // the primary Head Office while remaining COMPANY-scoped for access.
  baseHeadOfficeId String?            @db.Uuid
  status           DepartmentStatus   @default(DRAFT)
  version          Int                @default(0)
  createdAt        DateTime           @default(now()) @db.Timestamptz
  updatedAt        DateTime           @updatedAt @db.Timestamptz

  company              Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  // Composite FKs keep the scope target inside this company.
  project              Project?               @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Restrict)
  site                 Site?                  @relation(fields: [siteId, companyId], references: [id, companyId], onDelete: Restrict)
  // Department head must be an Employee of the same company.
  headEmployee         Employee?              @relation(fields: [headEmployeeId, companyId], references: [id, companyId], onDelete: Restrict)
  // Base Head Office must belong to the same company (location, not scope).
  baseHeadOffice       HeadOffice?            @relation(fields: [baseHeadOfficeId, companyId], references: [id, companyId], onDelete: Restrict)
  operations           Operation[]
  memberships          DepartmentMembership[]
  departmentOperations DepartmentOperation[]
  workSchedules        WorkSchedule[]
  leavePolicies        LeavePolicy[]

  // Scoped code uniqueness — company-wide rows are unambiguous; the same code
  // may repeat inside distinct project/site scopes (partial indexes in SQL).
  // Project-model keeps @([companyId,code]); Department's per-scope
  // constraint lives in migration SQL (Prisma cannot express partials).
  // Referenced by Operation's composite FK (departmentId, companyId).
  @@unique([id, companyId])
  // Company department list: WHERE companyId = ? [AND status = ?] ORDER BY id.
  @@index([companyId, status, id])
  // Project-scoped list: WHERE companyId = ? AND projectId = ? [AND status = ?].
  @@index([companyId, projectId, status, id])
  // Site-scoped list: WHERE companyId = ? AND siteId = ? [AND status = ?].
  @@index([companyId, siteId, status, id])
}

// ---------------------------------------------------------------------------
// Operation Engine: configurable operation definitions + published versions.
// ---------------------------------------------------------------------------

enum OperationStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

// Reusable operation definition owned by one Department; it inherits the
// department's Company/Project/Site scope (no independent scope fields).
model Operation {
  id               String          @id @default(uuid()) @db.Uuid
  companyId        String          @db.Uuid
  departmentId     String          @db.Uuid
  key              String // normalized, unique within the department
  name             String
  capabilityKey    String? // routing identifier — not a department name
  description      String?
  definition       Json? // bounded draft JSON; published snapshots are immutable
  status           OperationStatus @default(DRAFT)
  latestRevision   Int             @default(0)
  currentVersionId String?         @db.Uuid
  version          Int             @default(0)
  createdAt        DateTime        @default(now()) @db.Timestamptz
  updatedAt        DateTime        @updatedAt @db.Timestamptz

  company         Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  department      Department         @relation(fields: [departmentId, companyId], references: [id, companyId], onDelete: Restrict)
  // currentVersionId has NO Prisma relation — its composite FK
  // (currentVersionId, id, companyId) → OperationVersion(id, operationId,
  // companyId) is hand-added in the migration. It guarantees the pinned
  // version belongs to this operation and company.
  versions        OperationVersion[] @relation("OperationVersions")
  forms           Form[]
  rules           Rule[]
  formSubmissions FormSubmission[]

  // Operation keys are unique within a department.
  @@unique([companyId, departmentId, key])
  // Referenced by OperationVersion's composite FK (operationId, companyId).
  @@unique([id, companyId])
  // Operations under a department: WHERE companyId = ? AND departmentId = ? [AND status = ?].
  @@index([companyId, departmentId, status, id])
  // Company-wide operation lists: WHERE companyId = ? [AND status = ?].
  @@index([companyId, status, id])
}

// Immutable published snapshot of an operation definition. Append-only in
// application code — no update or delete paths exist.
model OperationVersion {
  id                     String   @id @default(uuid()) @db.Uuid
  companyId              String   @db.Uuid
  operationId            String   @db.Uuid
  revision               Int // strictly increasing per operation
  definition             Json // snapshot of the draft at publish time
  publishedAt            DateTime @default(now()) @db.Timestamptz
  publishedByPrincipalId String?  @db.Uuid // null only for SYSTEM/SERVICE actors
  createdAt              DateTime @default(now()) @db.Timestamptz

  company     Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  operation   Operation          @relation("OperationVersions", fields: [operationId, companyId], references: [id, companyId], onDelete: Restrict)
  publishedBy Principal?         @relation(fields: [publishedByPrincipalId], references: [id], onDelete: Restrict)
  workflows   Workflow[]
  instances   WorkflowInstance[]

  // Version history and monotonic ordering per operation.
  @@unique([companyId, operationId, revision])
  // Referenced by Operation's (currentVersionId, id, companyId) composite FK:
  // guarantees the pinned version belongs to that operation and company.
  @@unique([id, operationId, companyId])
}

// ---------------------------------------------------------------------------
// Form Builder: versioned form descriptors attached to operations.
// ---------------------------------------------------------------------------

enum FormStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

// Versioned form definition owned by one Operation; inherits the operation's
// company and department-derived scope. schema holds the validated draft
// descriptor; published FormVersion rows are immutable snapshots.
model Form {
  id               String     @id @default(uuid()) @db.Uuid
  companyId        String     @db.Uuid
  operationId      String     @db.Uuid
  key              String // normalized, unique within the operation
  name             String
  description      String?
  schema           Json? // draft descriptor — validated before persist/publish
  status           FormStatus @default(DRAFT)
  latestRevision   Int        @default(0)
  currentVersionId String?    @db.Uuid
  version          Int        @default(0)
  createdAt        DateTime   @default(now()) @db.Timestamptz
  updatedAt        DateTime   @updatedAt @db.Timestamptz

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  operation       Operation        @relation(fields: [operationId, companyId], references: [id, companyId], onDelete: Restrict)
  // currentVersionId has NO Prisma relation — the triple FK
  // (currentVersionId, id, companyId) → FormVersion(id, formId, companyId) is
  // hand-added in the migration so the pinned version belongs to this form.
  versions        FormVersion[]    @relation("FormVersions")
  formSubmissions FormSubmission[]

  // Form keys are unique within an operation.
  @@unique([companyId, operationId, key])
  // Referenced by FormVersion's composite FK (formId, companyId).
  @@unique([id, companyId])
  // Forms under an operation: WHERE companyId = ? AND operationId = ? [AND status = ?].
  @@index([companyId, operationId, status, id])
  // Company-wide form lists: WHERE companyId = ? [AND status = ?].
  @@index([companyId, status, id])
}

// Immutable published snapshot of a form descriptor. Append-only in
// application code — submissions (later) pin a specific FormVersion row.
model FormVersion {
  id                     String   @id @default(uuid()) @db.Uuid
  companyId              String   @db.Uuid
  formId                 String   @db.Uuid
  revision               Int // strictly increasing per form
  schema                 Json // snapshot of the draft descriptor at publish
  publishedAt            DateTime @default(now()) @db.Timestamptz
  publishedByPrincipalId String?  @db.Uuid // null only for SYSTEM/SERVICE actors
  createdAt              DateTime @default(now()) @db.Timestamptz

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  form            Form             @relation("FormVersions", fields: [formId, companyId], references: [id, companyId], onDelete: Restrict)
  publishedBy     Principal?       @relation(fields: [publishedByPrincipalId], references: [id], onDelete: Restrict)
  formSubmissions FormSubmission[]

  // Version history and monotonic ordering per form.
  @@unique([companyId, formId, revision])
  // Referenced by Form's (currentVersionId, id, companyId) composite FK.
  @@unique([id, formId, companyId])
}

// ---------------------------------------------------------------------------
// Workflow Definition Builder: versioned workflow definitions pinned to a
// published OperationVersion. Instances/runtime execution come later.
// ---------------------------------------------------------------------------

enum WorkflowStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

// Versioned workflow definition owned by one OperationVersion (therefore a
// specific published operation contract). definition holds the validated draft
// descriptor; WorkflowVersion rows are immutable snapshots.
model Workflow {
  id                 String         @id @default(uuid()) @db.Uuid
  companyId          String         @db.Uuid
  operationId        String         @db.Uuid
  operationVersionId String         @db.Uuid
  key                String // normalized, unique within the operation
  name               String
  description        String?
  definition         Json? // draft descriptor — validated before persist/publish
  status             WorkflowStatus @default(DRAFT)
  latestRevision     Int            @default(0)
  currentVersionId   String?        @db.Uuid
  version            Int            @default(0)
  createdAt          DateTime       @default(now()) @db.Timestamptz
  updatedAt          DateTime       @updatedAt @db.Timestamptz

  company          Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  // Composite FK: the pinned operation version must belong to THIS operation
  // and company.
  operationVersion OperationVersion   @relation(fields: [operationVersionId, operationId, companyId], references: [id, operationId, companyId], onDelete: Restrict)
  // currentVersionId has NO Prisma relation — the triple FK
  // (currentVersionId, id, companyId) → WorkflowVersion(id, workflowId,
  // companyId) is hand-added in the migration.
  versions         WorkflowVersion[]  @relation("WorkflowVersions")
  instances        WorkflowInstance[]

  // Workflow keys are unique within an operation.
  @@unique([companyId, operationId, key])
  // Referenced by WorkflowVersion's composite FK (workflowId, companyId).
  @@unique([id, companyId])
  // Workflows under an operation: WHERE companyId = ? AND operationId = ? [AND status = ?].
  @@index([companyId, operationId, status, id])
  // Company-wide workflow lists: WHERE companyId = ? [AND status = ?].
  @@index([companyId, status, id])
}

// Immutable published snapshot of a workflow definition. Append-only in
// application code — workflow instances (later) pin a specific revision.
model WorkflowVersion {
  id                     String   @id @default(uuid()) @db.Uuid
  companyId              String   @db.Uuid
  workflowId             String   @db.Uuid
  revision               Int // strictly increasing per workflow
  definition             Json // snapshot of the draft descriptor at publish
  publishedAt            DateTime @default(now()) @db.Timestamptz
  publishedByPrincipalId String?  @db.Uuid // null only for SYSTEM/SERVICE actors
  createdAt              DateTime @default(now()) @db.Timestamptz

  company     Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  workflow    Workflow           @relation("WorkflowVersions", fields: [workflowId, companyId], references: [id, companyId], onDelete: Restrict)
  publishedBy Principal?         @relation(fields: [publishedByPrincipalId], references: [id], onDelete: Restrict)
  instances   WorkflowInstance[]

  // Version history and monotonic ordering per workflow.
  @@unique([companyId, workflowId, revision])
  // Referenced by Workflow's (currentVersionId, id, companyId) composite FK.
  @@unique([id, workflowId, companyId])
}

// ---------------------------------------------------------------------------
// Rule Engine: versioned declarative rule definitions attached to operations.
// Evaluation is a pure library; execution side-effects are deferred.
// ---------------------------------------------------------------------------

enum RuleStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

// Versioned rule definition owned by one Operation; inherits the operation's
// company and department-derived scope. definition holds the validated draft
// descriptor; RuleVersion rows are immutable snapshots.
model Rule {
  id               String     @id @default(uuid()) @db.Uuid
  companyId        String     @db.Uuid
  operationId      String     @db.Uuid
  key              String // normalized, unique within the operation
  name             String
  description      String?
  definition       Json? // draft descriptor — validated before persist/publish
  status           RuleStatus @default(DRAFT)
  latestRevision   Int        @default(0)
  currentVersionId String?    @db.Uuid
  version          Int        @default(0)
  createdAt        DateTime   @default(now()) @db.Timestamptz
  updatedAt        DateTime   @updatedAt @db.Timestamptz

  company   Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  operation Operation     @relation(fields: [operationId, companyId], references: [id, companyId], onDelete: Restrict)
  // currentVersionId has NO Prisma relation — the triple FK
  // (currentVersionId, id, companyId) → RuleVersion(id, ruleId, companyId) is
  // hand-added in the migration.
  versions  RuleVersion[] @relation("RuleVersions")

  // Rule keys are unique within an operation.
  @@unique([companyId, operationId, key])
  // Referenced by RuleVersion's composite FK (ruleId, companyId).
  @@unique([id, companyId])
  // Rules under an operation: WHERE companyId = ? AND operationId = ? [AND status = ?].
  @@index([companyId, operationId, status, id])
  // Company-wide rule lists: WHERE companyId = ? [AND status = ?].
  @@index([companyId, status, id])
}

// Immutable published snapshot of a rule definition. Append-only in
// application code.
model RuleVersion {
  id                     String   @id @default(uuid()) @db.Uuid
  companyId              String   @db.Uuid
  ruleId                 String   @db.Uuid
  revision               Int // strictly increasing per rule
  definition             Json // snapshot of the draft descriptor at publish
  publishedAt            DateTime @default(now()) @db.Timestamptz
  publishedByPrincipalId String?  @db.Uuid // null only for SYSTEM/SERVICE actors
  createdAt              DateTime @default(now()) @db.Timestamptz

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  rule        Rule                 @relation("RuleVersions", fields: [ruleId, companyId], references: [id, companyId], onDelete: Restrict)
  publishedBy Principal?           @relation(fields: [publishedByPrincipalId], references: [id], onDelete: Restrict)
  transitions WorkflowTransition[]

  // Version history and monotonic ordering per rule.
  @@unique([companyId, ruleId, revision])
  // Referenced by Rule's (currentVersionId, id, companyId) composite FK.
  @@unique([id, ruleId, companyId])
  // Referenced by WorkflowTransition's composite FK (ruleVersionId, companyId).
  @@unique([id, companyId])
}

// ---------------------------------------------------------------------------
// Workflow instances: runtime execution pinned to immutable WorkflowVersion
// and OperationVersion snapshots. Transition rows are the auditable history.
// ---------------------------------------------------------------------------

// Shared transaction states (rule.md §8) — the same allowlist enforced on
// workflow descriptors.
enum WorkflowState {
  DRAFT
  SUBMITTED
  IN_REVIEW
  RETURNED
  APPROVED
  REJECTED
  IN_PROGRESS
  PARTIALLY_FULFILLED
  COMPLETED
  CANCELLED
  CLOSED
}

// A running workflow instance. The pinned WorkflowVersion snapshot is the law
// for its transitions — definition republish/archive does not mutate it.
model WorkflowInstance {
  id                   String        @id @default(uuid()) @db.Uuid
  companyId            String        @db.Uuid
  operationId          String        @db.Uuid
  workflowId           String        @db.Uuid
  workflowVersionId    String        @db.Uuid
  operationVersionId   String        @db.Uuid
  state                WorkflowState
  // Optional business-record BACK-REFERENCE only (no polymorphic FK possible —
  // referential integrity is application-level; business modules keep the
  // authoritative workflowInstanceId FK on their tables). Both columns must be
  // set together — enforced by CHECK in the migration.
  businessEntityType   String?
  businessEntityId     String?       @db.Uuid
  context              Json? // bounded server-constructed evaluation context
  version              Int           @default(0)
  startedByPrincipalId String?       @db.Uuid
  startedAt            DateTime      @default(now()) @db.Timestamptz
  closedAt             DateTime?     @db.Timestamptz
  createdAt            DateTime      @default(now()) @db.Timestamptz
  updatedAt            DateTime      @updatedAt @db.Timestamptz

  company          Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  workflow         Workflow               @relation(fields: [workflowId, companyId], references: [id, companyId], onDelete: Restrict)
  workflowVersion  WorkflowVersion        @relation(fields: [workflowVersionId, workflowId, companyId], references: [id, workflowId, companyId], onDelete: Restrict)
  operationVersion OperationVersion       @relation(fields: [operationVersionId, operationId, companyId], references: [id, operationId, companyId], onDelete: Restrict)
  startedBy        Principal?             @relation(fields: [startedByPrincipalId], references: [id], onDelete: Restrict)
  transitions      WorkflowTransition[]
  approvalTasks    ApprovalTask[]
  formSubmissions  FormSubmission[]
  documentLinks    DocumentLink[]
  fundingAttempts  WalletFundingAttempt[]

  // Referenced by WorkflowTransition's composite FK.
  @@unique([id, companyId])
  // Instances of a workflow (+state): WHERE companyId = ? AND workflowId = ? [AND state = ?].
  @@index([companyId, workflowId, state, id])
  // Instances under an operation (+state).
  @@index([companyId, operationId, state, id])
  // Company-wide instance lists (+state).
  @@index([companyId, state, id])
  // Business-record back-reference lookup (non-unique — one instance per
  // record is not a proven requirement yet).
  @@index([companyId, businessEntityType, businessEntityId])
}

// Append-only transition history — every successful state move with actor,
// reason, prior/next state, step, pinned rule version, and idempotency data.
model WorkflowTransition {
  id                 String        @id @default(uuid()) @db.Uuid
  companyId          String        @db.Uuid
  workflowInstanceId String        @db.Uuid
  fromState          WorkflowState
  toState            WorkflowState
  action             String
  stepKey            String
  actorPrincipalId   String?       @db.Uuid
  actorType          String
  reason             String?
  ruleVersionId      String?       @db.Uuid
  ruleOutcome        String?
  idempotencyKey     String?
  requestFingerprint String? // canonical command fingerprint for replay checks
  eventKey           String        @unique @db.Uuid
  occurredAt         DateTime      @default(now()) @db.Timestamptz

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  instance    WorkflowInstance @relation(fields: [workflowInstanceId, companyId], references: [id, companyId], onDelete: Restrict)
  actor       Principal?       @relation(fields: [actorPrincipalId], references: [id], onDelete: Restrict)
  ruleVersion RuleVersion?     @relation(fields: [ruleVersionId, companyId], references: [id, companyId], onDelete: Restrict)

  // Idempotent replay: same key per instance must carry the same fingerprint.
  @@unique([workflowInstanceId, idempotencyKey])
  // Transition history: WHERE companyId = ? AND workflowInstanceId = ?
  // ORDER BY occurredAt.
  @@index([companyId, workflowInstanceId, occurredAt, id])
}

// ---------------------------------------------------------------------------
// Approval Engine: single-approver tasks opened when an instance enters an
// approval stage. Decision rows are append-only outcome history.
// ---------------------------------------------------------------------------

enum ApprovalTaskStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
}

enum ApprovalOutcome {
  APPROVED
  REJECTED
  RETURNED
}

// One pending task per approval stage entry. Opened automatically when the
// instance arrives at a state that is the `from` of an APPROVAL-kind step
// group (a stage), and decided by exactly one authorized approver.
model ApprovalTask {
  id                   String             @id @default(uuid()) @db.Uuid
  companyId            String             @db.Uuid
  workflowInstanceId   String             @db.Uuid
  stageKey             String // normalized key linking the stage's pinned steps
  fromState            WorkflowState
  assigneeType         String // copied from the pinned step at open time
  assigneeValue        String?
  selfApprove          Boolean            @default(false)
  status               ApprovalTaskStatus @default(PENDING)
  decidedByPrincipalId String?            @db.Uuid
  decidedAt            DateTime?          @db.Timestamptz
  decisionAction       String? // APPROVE | REJECT | RETURN applied
  decisionReason       String?
  version              Int                @default(0)
  createdAt            DateTime           @default(now()) @db.Timestamptz
  updatedAt            DateTime           @updatedAt @db.Timestamptz

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  instance  WorkflowInstance   @relation(fields: [workflowInstanceId, companyId], references: [id, companyId], onDelete: Restrict)
  decidedBy Principal?         @relation(fields: [decidedByPrincipalId], references: [id], onDelete: Restrict)
  decisions ApprovalDecision[]

  // Referenced by ApprovalDecision's composite FK.
  @@unique([id, companyId])
  // Task list per instance (+status): WHERE companyId = ? AND workflowInstanceId = ? [AND status = ?].
  @@index([companyId, workflowInstanceId, status, id])
  // Company-wide task lists (+status).
  @@index([companyId, status, id])
  // "My pending tasks" per assignee spec.
  @@index([companyId, assigneeType, assigneeValue, status])
}

// Append-only decision outcome. Exactly one row per decided task.
model ApprovalDecision {
  id                 String          @id @default(uuid()) @db.Uuid
  companyId          String          @db.Uuid
  approvalTaskId     String          @db.Uuid
  outcome            ApprovalOutcome
  action             String // APPROVE | REJECT | RETURN — the pinned action applied
  actorPrincipalId   String?         @db.Uuid
  actorType          String
  reason             String?
  idempotencyKey     String?
  requestFingerprint String? // sha256 of the semantic command
  decisionPayload    Json? // action-specific payload (e.g. approvedAmount) — part of history + fingerprint
  eventKey           String          @unique @db.Uuid
  decidedAt          DateTime        @default(now()) @db.Timestamptz

  company Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  task    ApprovalTask @relation(fields: [approvalTaskId, companyId], references: [id, companyId], onDelete: Restrict)
  actor   Principal?   @relation(fields: [actorPrincipalId], references: [id], onDelete: Restrict)

  // One decision per idempotency key per task.
  @@unique([approvalTaskId, idempotencyKey])
  // Decision history for a task.
  @@index([companyId, approvalTaskId, decidedAt, id])
}

// ---------------------------------------------------------------------------
// Form Submission Engine: workflow-linked submissions. The envelope is
// mutable (draft staging + status); every submit appends an immutable
// SubmissionRevision — the ONLY source guard evaluation may read.
// ---------------------------------------------------------------------------

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  RETURNED
}

model FormSubmission {
  id                     String           @id @default(uuid()) @db.Uuid
  companyId              String           @db.Uuid
  operationId            String           @db.Uuid
  workflowInstanceId     String           @db.Uuid
  formId                 String           @db.Uuid
  formVersionId          String           @db.Uuid
  status                 SubmissionStatus @default(DRAFT)
  draftValues            Json? // staging only — guards never read this
  latestRevision         Int              @default(0)
  currentRevisionId      String?          @db.Uuid
  submittedByPrincipalId String?          @db.Uuid
  submittedAt            DateTime?        @db.Timestamptz
  returnedReason         String?
  version                Int              @default(0)
  createdAt              DateTime         @default(now()) @db.Timestamptz
  updatedAt              DateTime         @updatedAt @db.Timestamptz

  company       Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  operation     Operation            @relation(fields: [operationId, companyId], references: [id, companyId], onDelete: Restrict)
  instance      WorkflowInstance     @relation(fields: [workflowInstanceId, companyId], references: [id, companyId], onDelete: Restrict)
  form          Form                 @relation(fields: [formId, companyId], references: [id, companyId], onDelete: Restrict)
  formVersion   FormVersion          @relation(fields: [formVersionId, formId, companyId], references: [id, formId, companyId], onDelete: Restrict)
  submittedBy   Principal?           @relation(fields: [submittedByPrincipalId], references: [id], onDelete: Restrict)
  // currentRevisionId has NO Prisma relation — the triple FK
  // (currentRevisionId, id, companyId) → SubmissionRevision(id, submissionId, companyId)
  // is hand-added in the migration so the pointer can't leave this submission.
  revisions     SubmissionRevision[] @relation("SubmissionRevisions")
  documentLinks DocumentLink[]

  // One submission per form-version per instance — the guard-lookup key.
  @@unique([companyId, workflowInstanceId, formVersionId])
  // Referenced by SubmissionRevision's composite FK.
  @@unique([id, companyId])
  // Submissions under an operation: WHERE companyId = ? AND operationId = ? [AND status = ?].
  @@index([companyId, operationId, status, id])
  // An instance's submissions (+status): approval-RETURN coupling and instance views.
  @@index([companyId, workflowInstanceId, status])
}

// Immutable snapshot of one accepted submission. Append-only in application
// code — resubmission appends the next revision and moves the pointer.
model SubmissionRevision {
  id                     String   @id @default(uuid()) @db.Uuid
  companyId              String   @db.Uuid
  submissionId           String   @db.Uuid
  revision               Int // strictly increasing per submission
  values                 Json // validated at submit; ≤64KiB, JSON-safe
  submittedAt            DateTime @default(now()) @db.Timestamptz
  submittedByPrincipalId String?  @db.Uuid
  idempotencyKey         String?
  requestFingerprint     String?
  eventKey               String   @unique @db.Uuid

  company     Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  submission  FormSubmission @relation("SubmissionRevisions", fields: [submissionId, companyId], references: [id, companyId], onDelete: Restrict)
  submittedBy Principal?     @relation(fields: [submittedByPrincipalId], references: [id], onDelete: Restrict)

  // Revision history and monotonic ordering per submission.
  @@unique([companyId, submissionId, revision])
  // Referenced by FormSubmission's (currentRevisionId, id, companyId) FK.
  @@unique([id, submissionId, companyId])
  // One accepted submission command per idempotency key.
  @@unique([submissionId, idempotencyKey])
}

// ---------------------------------------------------------------------------
// Document Service: private file objects + constrained entity links.
// storageKey is server-generated; the row is authority for every object.
// Links are append-friendly (unlinkedAt soft-unlink preserves history).
// ---------------------------------------------------------------------------

enum DocumentStatus {
  UPLOADING
  QUARANTINED
  AVAILABLE
  REJECTED
  ARCHIVED
}

model Document {
  id                    String         @id @default(uuid()) @db.Uuid
  companyId             String         @db.Uuid
  storageKey            String
  originalFileName      String // sanitized display name — never a path
  declaredContentType   String?
  contentType           String? // server-sniffed
  sizeBytes             Int?
  sha256                String?
  status                DocumentStatus @default(UPLOADING)
  rejectReason          String?
  uploadedByPrincipalId String?        @db.Uuid
  uploadedAt            DateTime       @default(now()) @db.Timestamptz
  reviewedByPrincipalId String?        @db.Uuid
  reviewedAt            DateTime?      @db.Timestamptz
  // Upload scope — captured at upload, immutable; mirrors RoleAssignment.
  // The matching column is enforced non-null by migration CHECK.
  scopeType             ScopeType      @default(COMPANY)
  headOfficeId          String?        @db.Uuid
  projectId             String?        @db.Uuid
  siteId                String?        @db.Uuid
  version               Int            @default(0)
  createdAt             DateTime       @default(now()) @db.Timestamptz
  updatedAt             DateTime       @updatedAt @db.Timestamptz

  company              Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  uploadedBy           Principal?          @relation("DocumentUploader", fields: [uploadedByPrincipalId], references: [id], onDelete: Restrict)
  reviewedBy           Principal?          @relation("DocumentReviewer", fields: [reviewedByPrincipalId], references: [id], onDelete: Restrict)
  // Composite FKs keep the scope target inside this company.
  headOffice           HeadOffice?         @relation(fields: [headOfficeId, companyId], references: [id, companyId], onDelete: Restrict)
  project              Project?            @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Restrict)
  site                 Site?               @relation(fields: [siteId, companyId], references: [id, companyId], onDelete: Restrict)
  links                DocumentLink[]
  complianceRecords    ComplianceRecord[]
  employeeDocuments    EmployeeDocument[]
  signedWalletVouchers WalletCashVoucher[]
  landParcels          ProjectLandParcel[]
  projectDocuments     ProjectDocument[]
  siteDocuments        SiteDocument[]
  projectApprovals     ProjectApproval[]

  @@unique([id, companyId])
  @@unique([companyId, storageKey])
  // "My uploads", quarantine/review queue, scoped review.
  @@index([companyId, uploadedByPrincipalId, uploadedAt, id])
  @@index([companyId, status, uploadedAt, id])
  @@index([companyId, scopeType])
}

// Constrained polymorphism: entityType is derived, exactly one concrete FK
// is set (migration check constraint), each composite-FK'd to company.
model DocumentLink {
  id                     String    @id @default(uuid()) @db.Uuid
  companyId              String    @db.Uuid
  documentId             String    @db.Uuid
  entityType             String // FORM_SUBMISSION | WORKFLOW_INSTANCE | WALLET_FUNDING_REQUEST | WALLET_TRANSFER | WALLET_EXPENSE | WALLET_LEDGER_ENTRY | WALLET_VOUCHER
  formSubmissionId       String?   @db.Uuid
  workflowInstanceId     String?   @db.Uuid
  walletFundingRequestId String?   @db.Uuid
  walletTransferId       String?   @db.Uuid
  walletExpenseId        String?   @db.Uuid
  walletLedgerEntryId    String?   @db.Uuid
  walletVoucherId        String?   @db.Uuid
  fieldKey               String? // FILE/IMAGE field on the pinned FormVersion
  linkedByPrincipalId    String?   @db.Uuid
  linkedAt               DateTime  @default(now()) @db.Timestamptz
  unlinkedAt             DateTime? @db.Timestamptz
  unlinkedByPrincipalId  String?   @db.Uuid
  version                Int       @default(0)
  createdAt              DateTime  @default(now()) @db.Timestamptz
  updatedAt              DateTime  @updatedAt @db.Timestamptz

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  document             Document              @relation(fields: [documentId, companyId], references: [id, companyId], onDelete: Restrict)
  formSubmission       FormSubmission?       @relation(fields: [formSubmissionId, companyId], references: [id, companyId], onDelete: Restrict)
  instance             WorkflowInstance?     @relation(fields: [workflowInstanceId, companyId], references: [id, companyId], onDelete: Restrict)
  walletFundingRequest WalletFundingRequest? @relation(fields: [walletFundingRequestId, companyId], references: [id, companyId], onDelete: Restrict)
  walletTransfer       WalletTransfer?       @relation(fields: [walletTransferId, companyId], references: [id, companyId], onDelete: Restrict)
  walletExpense        WalletExpense?        @relation(fields: [walletExpenseId, companyId], references: [id, companyId], onDelete: Restrict)
  walletLedgerEntry    WalletLedgerEntry?    @relation(fields: [walletLedgerEntryId, companyId], references: [id, companyId], onDelete: Restrict)
  walletVoucher        WalletCashVoucher?    @relation(fields: [walletVoucherId, companyId], references: [id, companyId], onDelete: Restrict)
  linkedBy             Principal?            @relation("DocumentLinker", fields: [linkedByPrincipalId], references: [id], onDelete: Restrict)
  unlinkedBy           Principal?            @relation("DocumentUnlinker", fields: [unlinkedByPrincipalId], references: [id], onDelete: Restrict)

  @@unique([id, companyId])
  @@index([companyId, documentId, unlinkedAt])
  @@index([companyId, formSubmissionId, unlinkedAt])
  @@index([companyId, workflowInstanceId, unlinkedAt])
  @@index([companyId, walletFundingRequestId, unlinkedAt])
  @@index([companyId, walletTransferId, unlinkedAt])
  @@index([companyId, walletExpenseId, unlinkedAt])
  @@index([companyId, walletLedgerEntryId, unlinkedAt])
  @@index([companyId, walletVoucherId, unlinkedAt])
}

model EmployeeDocument {
  id                    String                     @id @default(uuid()) @db.Uuid
  companyId             String                     @db.Uuid
  employeeId            String                     @db.Uuid
  documentId            String                     @db.Uuid
  documentType          EmployeeDocumentType
  title                 String
  documentNumber        String?
  issuingAuthority      String?
  issueDate             DateTime?                  @db.Date
  expiryDate            DateTime?                  @db.Date
  verificationStatus    DocumentVerificationStatus @default(PENDING)
  verifiedByPrincipalId String?                    @db.Uuid
  verifiedAt            DateTime?                  @db.Timestamptz
  rejectionReason       String?
  metadata              Json?
  version               Int                        @default(0)
  createdAt             DateTime                   @default(now()) @db.Timestamptz
  updatedAt             DateTime                   @updatedAt @db.Timestamptz

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee   Employee   @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)
  document   Document   @relation(fields: [documentId, companyId], references: [id, companyId], onDelete: Restrict)
  verifiedBy Principal? @relation("EmployeeDocVerifier", fields: [verifiedByPrincipalId], references: [id], onDelete: Restrict)

  @@unique([id, companyId])
  @@index([companyId, employeeId, documentType])
  @@index([companyId, expiryDate])
  @@index([companyId, verificationStatus])
}

// ---------------------------------------------------------------------------
// Notifications: transactional outbox + durable inbox.
// OutboxEvent is written in the SAME tx as the business change (emit-side);
// the relay turns it into durable Notification rows, then publishes.
// ---------------------------------------------------------------------------

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  DEAD
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  companyId     String       @db.Uuid
  eventType     String // WORKFLOW_TRANSITIONED | APPROVAL_TASK_OPENED | APPROVAL_TASK_DECIDED | DOCUMENT_APPROVED | DOCUMENT_REJECTED
  aggregateType String
  aggregateId   String       @db.Uuid
  payload       Json // safe fields only — ids, statuses, recipient principal ids
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  leaseUntil    DateTime?    @db.Timestamptz
  nextAttemptAt DateTime     @default(now()) @db.Timestamptz
  lastError     String?
  processedAt   DateTime?    @db.Timestamptz
  eventKey      String // unique per occurrence — e.g. evt:{aggregate}:{type}:{occurrence}
  createdAt     DateTime     @default(now()) @db.Timestamptz
  updatedAt     DateTime     @updatedAt @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, eventKey])
  // Relay poll: pending events due now; lease-expiry sweep.
  @@index([status, nextAttemptAt, id])
  @@index([status, leaseUntil])
}

model Notification {
  id                   String    @id @default(uuid()) @db.Uuid
  companyId            String    @db.Uuid
  recipientPrincipalId String    @db.Uuid
  eventType            String
  title                String
  body                 String?
  resourceType         String
  resourceId           String    @db.Uuid
  eventKey             String // source outbox event key
  readAt               DateTime? @db.Timestamptz
  publishedAt          DateTime? @db.Timestamptz // null = durable but not yet pushed
  version              Int       @default(0)
  createdAt            DateTime  @default(now()) @db.Timestamptz
  updatedAt            DateTime  @updatedAt @db.Timestamptz

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  recipient Principal @relation(fields: [recipientPrincipalId], references: [id], onDelete: Restrict)

  // Dedupe = company + recipient + occurrence.
  @@unique([companyId, recipientPrincipalId, eventKey])
  // Inbox + cursor paging: WHERE recipient=? AND companyId=? ORDER BY createdAt,id.
  @@index([recipientPrincipalId, companyId, createdAt, id])
  @@index([companyId, publishedAt])
}

// Single-use account claim code — stores only a SHA-256 hash of the raw code.
// The raw code is returned once to the issuer and never persisted.
// Lifecycle: consumedAt IS NULL = active; consumedAt is set BOTH when the
// code is claimed and when it is invalidated by reissue (a "closed" code —
// either way it can never be used again). Active count per principal is
// capped at one by ClaimToken_one_active_per_principal.
// purpose binds the code to the ONE operation it may perform — NULL is
// allowed only on already-closed legacy rows (ClaimToken_purpose_binding_ck).
enum ClaimTokenPurpose {
  // Activate the company's first admin AND complete company/HO onboarding.
  COMPANY_ONBOARD
  // Activate the bound employee's login only — never company data.
  EMPLOYEE_INVITE
}

model ClaimToken {
  id          String             @id @default(uuid()) @db.Uuid
  principalId String             @db.Uuid
  tokenHash   String             @unique
  purpose     ClaimTokenPurpose?
  companyId   String?            @db.Uuid
  employeeId  String?            @db.Uuid
  expiresAt   DateTime           @db.Timestamptz
  consumedAt  DateTime?          @db.Timestamptz
  createdAt   DateTime           @default(now()) @db.Timestamptz

  principal Principal @relation(fields: [principalId], references: [id], onDelete: Restrict)
  // Bound tenant context — COMPANY_ONBOARD carries the company being
  // onboarded; EMPLOYEE_INVITE carries the employee's company.
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  // EMPLOYEE_INVITE only. The triple composite FK enforces company match
  // AND that the token's principalId is the employee's linked principal —
  // a same-company FK alone would let a token bind to someone else's row.
  employee  Employee? @relation(fields: [employeeId, companyId, principalId], references: [id, companyId, principalId], onDelete: Restrict)

  @@index([principalId, consumedAt])
  @@index([companyId, employeeId, consumedAt])
}

enum CompanyEntityType {
  PRIVATE_LIMITED
  PUBLIC_LIMITED
  LLP
  PARTNERSHIP
  PROPRIETORSHIP
  OTHER
}

enum ComplianceCategory {
  GST
  TAN
  UDYAM_MSME
  EPFO
  ESIC
  BOCW
  LABOUR_LICENCE
  CONTRACTOR_ENLISTMENT
  ISO_CERT
  TECHNICAL_LICENCE
  INSURANCE
  OTHER
}

enum ComplianceRecordStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  EXPIRED
  ARCHIVED
}

// Company-scoped compliance record — GST registrations, licences, certs,
// insurance. Optional/applicability-dependent; never legal requirements.
// Attachments reference Document ids (same-company, AVAILABLE at link time).
model ComplianceRecord {
  id               String                 @id @default(uuid()) @db.Uuid
  companyId        String                 @db.Uuid
  category         ComplianceCategory
  customLabel      String? // required when category = OTHER
  identifier       String // GSTIN / licence / policy number — masked in audit
  jurisdiction     String? // state/UT or issuing jurisdiction
  issuingAuthority String?
  scopeType        ScopeType              @default(COMPANY)
  issueDate        DateTime?              @db.Date
  expiryDate       DateTime?              @db.Date
  status           ComplianceRecordStatus @default(DRAFT)
  verifiedAt       DateTime?              @db.Timestamptz
  verifiedBy       String?                @db.Uuid
  documentId       String?                @db.Uuid
  version          Int                    @default(0)
  createdAt        DateTime               @default(now()) @db.Timestamptz
  updatedAt        DateTime               @updatedAt @db.Timestamptz

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  document Document? @relation(fields: [documentId, companyId], references: [id, companyId], onDelete: Restrict)

  // Duplicate identifier prevention within a company per category.
  @@unique([companyId, category, identifier])
  @@unique([id, companyId])
  @@index([companyId, status, category])
}

// Why a membership ended — appended at end time, never rewritten.
// SUSPENDED is restorable via reinstatement (a NEW row); EXITED is not.
// Null on legacy rows = "ended by an unspecified flow".
enum DepartmentMembershipEndReason {
  PLACEMENT_END
  TRANSFERRED
  SUSPENDED
  EXITED
  DEACTIVATED
}

// Effective-dated organizational placement of an Employee in a Department.
// Placement only — it NEVER grants API permission; role assignments do that.
// A row is ACTIVE iff endedAt IS NULL (single source of truth, no status col).
model DepartmentMembership {
  id           String                         @id @default(uuid()) @db.Uuid
  companyId    String                         @db.Uuid
  employeeId   String                         @db.Uuid
  departmentId String                         @db.Uuid
  isPrimary    Boolean                        @default(false)
  startedAt    DateTime                       @default(now()) @db.Timestamptz
  endedAt      DateTime?                      @db.Timestamptz
  // Lifecycle end metadata — set once when the row ends, never rewritten.
  endReason    DepartmentMembershipEndReason?
  endNote      String? // audit-grade context; never in feed/notifications
  suspendUntil DateTime?                      @db.Date // structured expected-return date (SUSPENDED only)
  // Links an ended row to the new membership that reinstated it. Composite
  // FK keeps the replacement inside the same company AND employee.
  supersededBy String?                        @db.Uuid
  version      Int                            @default(0)
  createdAt    DateTime                       @default(now()) @db.Timestamptz
  updatedAt    DateTime                       @updatedAt @db.Timestamptz

  company                Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee               Employee               @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)
  department             Department             @relation(fields: [departmentId, companyId], references: [id, companyId], onDelete: Restrict)
  supersededByMembership DepartmentMembership?  @relation("MembershipSupersession", fields: [companyId, employeeId, supersededBy], references: [companyId, employeeId, id], onDelete: Restrict)
  supersedes             DepartmentMembership[] @relation("MembershipSupersession")

  // Partial unique indexes (in migration SQL):
  //   one ACTIVE membership per (employee, department): WHERE "endedAt" IS NULL
  //   one ACTIVE PRIMARY per (employee, company):    WHERE "endedAt" IS NULL AND "isPrimary"
  @@unique([id, companyId])
  // Composite FK target for supersededBy — same-company, same-employee.
  @@unique([companyId, employeeId, id])
  @@index([companyId, employeeId, endedAt])
  @@index([companyId, departmentId, endedAt])
}

// Append-only marker: an employee was permanently exited from a site or
// project workforce. Reinstatement of SUSPENDED rows is blocked while a
// covering marker exists. Exactly one of siteId/projectId is set (CHECK).
// Does NOT block fresh placement — it records the decision, not a ban.
model SiteWorkforceExit {
  id                  String   @id @default(uuid()) @db.Uuid
  companyId           String   @db.Uuid
  employeeId          String   @db.Uuid
  siteId              String?  @db.Uuid
  projectId           String?  @db.Uuid
  exitedAt            DateTime @default(now()) @db.Timestamptz
  exitedByPrincipalId String?  @db.Uuid
  note                String?

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee Employee   @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)
  site     Site?      @relation(fields: [siteId, companyId], references: [id, companyId], onDelete: Restrict)
  project  Project?   @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Restrict)
  exitedBy Principal? @relation("SiteWorkforceExitActor", fields: [exitedByPrincipalId], references: [id], onDelete: Restrict)

  // Partial unique indexes (in migration SQL):
  //   (companyId, employeeId, siteId)    WHERE siteId IS NOT NULL
  //   (companyId, employeeId, projectId) WHERE projectId IS NOT NULL
  // CHECK (num_nonnulls(siteId, projectId) = 1)
  @@unique([id, companyId])
  @@index([companyId, employeeId])
}

// Global, read-only operation catalogue — the master list of work types an
// admin can enable on departments. Seeded by migration; no companyId.
model OperationCatalogueEntry {
  key                   String      @id
  domain                String // EMPLOYEE_RECORDS|PAYROLL|BILLING|QUOTATION|WALLET|REPORT
  name                  String
  description           String
  sensitive             Boolean     @default(false)
  // Department scopes this operation may be enabled on. A DepartmentOperation
  // row is only valid when the department's scopeType is in this list.
  appliesTo             ScopeType[] @default([COMPANY])
  // Whether PROJECT-scoped leadership roles (PD/PI) inherit this operation
  // from departments under their assigned projects/sites. Defaults false —
  // only explicitly reviewed, project-relevant ops may be set true. Approval,
  // payment, payroll, and other high-impact ops must never be inherited.
  leadershipInheritable Boolean     @default(false)

  departmentOperations DepartmentOperation[]
  employeeOperations   EmployeeOperation[]

  @@index([domain])
}

// Which operations a department is enabled to perform. Placement is a row's
// existence — no status field.
model DepartmentOperation {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  departmentId String   @db.Uuid
  operationKey String
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now()) @db.Timestamptz

  company    Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  department Department              @relation(fields: [departmentId, companyId], references: [id, companyId], onDelete: Restrict)
  operation  OperationCatalogueEntry @relation(fields: [operationKey], references: [key])

  @@unique([companyId, departmentId, operationKey])
  @@index([companyId, departmentId])
}

// Which of a department's enabled operations an employee may perform —
// a strict subset validated against the employee's active memberships.
model EmployeeOperation {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  employeeId   String   @db.Uuid
  operationKey String
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now()) @db.Timestamptz

  company   Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee  Employee                @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)
  operation OperationCatalogueEntry @relation(fields: [operationKey], references: [key])

  @@unique([companyId, employeeId, operationKey])
  @@index([companyId, employeeId])
}

// ---------------------------------------------------------------------------
// Attendance Management (Milestone Phase 1)
// ---------------------------------------------------------------------------

enum AttendanceSessionStatus {
  IN_PROGRESS
  COMPLETED
  AUTO_CLOSED
  REJECTED
}

enum AttendanceSource {
  MOBILE_SELF
  SUPERVISOR_KIOSK
  BIOMETRIC_DEVICE
  MANUAL_CORRECTION
}

enum BreakMode {
  FIXED
  DYNAMIC
}

enum OvertimeMode {
  HOURLY
  P_MULTIPLIER
}

// Shared scope vocabulary for effective-dated configuration records
// (attendance policies, leave policies, work schedules). DEPARTMENT targets the
// real Department record — an HO-based department (e.g. Finance) stays
// company-scoped for authorization; its baseHeadOfficeId is location only.
enum AttendancePolicyScope {
  COMPANY
  DEPARTMENT
  PROJECT
  SITE
  EMPLOYEE
}

// Intraday break configuration on a work-schedule revision. FIXED_WINDOW =
// scheduled break deducted automatically (no break punches); DYNAMIC =
// employee-punched breaks bounded by the configured window/duration limits.
// NULL breakWindowMode on a revision means day-pattern only — the legacy
// AttendancePolicy breakMode continues to govern.
enum BreakWindowMode {
  FIXED_WINDOW
  DYNAMIC
}

// Scheduled clock-out enforcement on a work-schedule revision.
// DISABLED = never auto-close; AT_SCHEDULED_END = close exactly at the
// scheduled end instant; AFTER_GRACE = close at scheduled end plus
// autoClockOutGraceMins. NULL = no scheduled-end enforcement.
enum AutoClockOutMode {
  DISABLED
  AT_SCHEDULED_END
  AFTER_GRACE
}

model AttendancePolicy {
  id          String                @id @default(uuid()) @db.Uuid
  companyId   String                @db.Uuid
  scope       AttendancePolicyScope @default(COMPANY)
  projectId   String?               @db.Uuid
  siteId      String?               @db.Uuid
  employeeId  String?               @db.Uuid
  name        String
  description String?

  // 8:00 AM - 8:00 AM Construction cycle anchor
  dayStartHour   Int @default(8)
  dayStartMinute Int @default(0)

  // Shift & Work thresholds in minutes
  shiftDurationMins    Int @default(480) // 8 hours
  halfDayThresholdMins Int @default(240) // 4 hours
  fullDayThresholdMins Int @default(480) // 8 hours

  // Break Policy
  breakMode           BreakMode @default(FIXED)
  fixedBreakMins      Int       @default(60)
  minWorkForBreakMins Int       @default(240)
  maxDynamicBreakMins Int       @default(90)

  // Overtime Policy
  overtimeMode     OvertimeMode @default(HOURLY)
  minOvertimeMins  Int          @default(30)
  otSlabMins       Int          @default(30)
  // Dynamic P Multiplier Slabs (JSON array):
  // e.g. [{"minExtraMins": 120, "pUnit": 0.5}, {"minExtraMins": 240, "pUnit": 1.0}, {"minExtraMins": 480, "pUnit": 2.0}]
  pMultiplierSlabs Json?

  // Geofence & Punch Controls
  geofenceStrict   Boolean @default(true)
  allowMobilePunch Boolean @default(true)
  allowKioskPunch  Boolean @default(true)
  allowBiometric   Boolean @default(true)

  // Safety Toolbox Talk (TVT) Gate
  requireTvtGate Boolean @default(false)
  tvtGateAction  String  @default("FLAG") // "BLOCK" | "FLAG"

  status    OrgNodeStatus @default(ACTIVE)
  version   Int           @default(0)
  createdAt DateTime      @default(now()) @db.Timestamptz
  updatedAt DateTime      @updatedAt @db.Timestamptz

  company  Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project  Project?            @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Restrict)
  site     Site?               @relation(fields: [siteId, companyId], references: [id, companyId], onDelete: Restrict)
  employee Employee?           @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)
  sessions AttendanceSession[]

  @@unique([id, companyId])
  @@index([companyId, scope])
  @@index([companyId, siteId])
  @@index([companyId, projectId])
  @@index([companyId, employeeId])
}

model AttendanceSession {
  id           String  @id @default(uuid()) @db.Uuid
  companyId    String  @db.Uuid
  employeeId   String  @db.Uuid
  // Exactly one of siteId / headOfficeId is set (enforced by
  // AttendanceSession_location_check): construction sites punch against a
  // Site; Head-Office-department staff punch against their Head Office.
  siteId       String? @db.Uuid
  headOfficeId String? @db.Uuid
  policyId     String  @db.Uuid

  // Business date for the 8 AM - 8 AM construction cycle, e.g. "2026-11-17"
  businessDate String                  @db.VarChar(10)
  status       AttendanceSessionStatus @default(IN_PROGRESS)
  source       AttendanceSource        @default(MOBILE_SELF)

  // Punch In details
  punchInAt             DateTime @db.Timestamptz
  punchInLat            Decimal? @db.Decimal(10, 7)
  punchInLng            Decimal? @db.Decimal(10, 7)
  punchInDistanceM      Int?
  punchInWithinGeofence Boolean  @default(true)
  punchInRemarks        String?
  punchInSupervisorId   String?  @db.Uuid

  // Punch Out details
  punchOutAt             DateTime? @db.Timestamptz
  punchOutLat            Decimal?  @db.Decimal(10, 7)
  punchOutLng            Decimal?  @db.Decimal(10, 7)
  punchOutDistanceM      Int?
  punchOutWithinGeofence Boolean?
  punchOutRemarks        String?
  punchOutSupervisorId   String?   @db.Uuid

  // Computed durations (minutes)
  grossDurationMins Int @default(0)
  breakDurationMins Int @default(0)
  netDurationMins   Int @default(0)

  // Present & Overtime Units
  presentUnits   Decimal @default(0) @db.Decimal(3, 1)
  overtimePUnits Decimal @default(0) @db.Decimal(3, 1)
  totalPUnits    Decimal @default(0) @db.Decimal(3, 1)
  overtimeHours  Decimal @default(0) @db.Decimal(4, 2)

  // Anomaly / Flags
  isFlagged  Boolean   @default(false)
  flagReason String?
  approvedBy String?   @db.Uuid
  approvedAt DateTime? @db.Timestamptz

  // Offline Kiosk & Sync Support
  clientSessionId String? @db.Uuid
  syncBatchId     String? @db.Uuid
  isSyncedOffline Boolean @default(false)

  // Immutable punch-time snapshot — resolved at session creation so later
  // schedule/policy edits never reclassify this session. NULL on rows that
  // predate intraday schedules or where no schedule revision resolved.
  // policySnapshot carries the calc-relevant AttendancePolicy + resolved
  // intraday values as JSON (see attendance service buildPolicySnapshot).
  scheduleRevisionId    String?   @db.Uuid
  policySnapshot        Json?
  scheduledStartAt      DateTime? @db.Timestamptz
  scheduledEndAt        DateTime? @db.Timestamptz
  autoClockOutMode      AutoClockOutMode?
  autoClockOutGraceMins Int?
  // Who auto-closed the session: SCHEDULED_END | EOD_SETTLEMENT | STALE_SWEEP.
  // NULL = closed by an explicit punch-out or regularization.
  autoClosedBy String? @db.VarChar(24)

  version   Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee   Employee          @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)
  site       Site?             @relation(fields: [siteId, companyId], references: [id, companyId], onDelete: Restrict)
  headOffice HeadOffice?       @relation(fields: [headOfficeId, companyId], references: [id, companyId], onDelete: Restrict)
  policy     AttendancePolicy  @relation(fields: [policyId, companyId], references: [id, companyId], onDelete: Restrict)
  scheduleRevision WorkScheduleRevision? @relation(fields: [scheduleRevisionId, companyId], references: [id, companyId], onDelete: Restrict)
  breaks     AttendanceBreak[]

  @@unique([id, companyId])
  @@index([companyId, businessDate])
  @@index([companyId, employeeId, businessDate])
  @@index([companyId, siteId, businessDate])
  @@index([companyId, headOfficeId, businessDate])
  @@index([companyId, status])
  @@index([companyId, clientSessionId])
}

model AttendanceBreak {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  sessionId    String    @db.Uuid
  breakType    String    @default("LUNCH")
  startedAt    DateTime  @db.Timestamptz
  endedAt      DateTime? @db.Timestamptz
  durationMins Int       @default(0)
  isApproved   Boolean   @default(true)
  remarks      String?
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz

  company Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  session AttendanceSession @relation(fields: [sessionId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([id, companyId])
  @@index([companyId, sessionId])
}

// ---------------------------------------------------------------------------
// Daily Site Report (DSR) & End-of-Day Settlement Engine
// ---------------------------------------------------------------------------

enum DailyReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  LOCKED
}

enum WeatherCondition {
  CLEAR
  OVERCAST
  LIGHT_RAIN
  HEAVY_RAIN
  STORMY
  EXTREME_HEAT
}

enum LabourCategory {
  CAT_A_STAFF
  CAT_B_DIRECT_LABOUR
  CAT_C_SUBCONTRACTOR
}

model DailySiteReport {
  id           String            @id @default(uuid()) @db.Uuid
  companyId    String            @db.Uuid
  projectId    String            @db.Uuid
  siteId       String            @db.Uuid
  businessDate String            @db.VarChar(10) // e.g. "2026-11-21"
  status       DailyReportStatus @default(DRAFT)

  // Site & Environmental Conditions
  weather                WeatherCondition @default(CLEAR)
  weatherStoppageHours   Decimal          @default(0) @db.Decimal(4, 2)
  workProgressNotes      String?          @db.Text
  siteObstaclesRemarks   String?          @db.Text
  safetyIncidentReported Boolean          @default(false)
  safetyNotes            String?          @db.Text

  // Aggregated Workforce Totals (Materialized Snapshot)
  totalWorkersHeadcount Int     @default(0)
  totalPresentUnits     Decimal @default(0) @db.Decimal(6, 1)
  totalOvertimeHours    Decimal @default(0) @db.Decimal(6, 2)
  totalOvertimePUnits   Decimal @default(0) @db.Decimal(6, 1)
  totalFlaggedSessions  Int     @default(0)

  // Category Breakdown Totals
  catAStaffCount  Int     @default(0)
  catAStaffUnits  Decimal @default(0) @db.Decimal(6, 1)
  catBDirectCount Int     @default(0)
  catBDirectUnits Decimal @default(0) @db.Decimal(6, 1)
  catCSubconCount Int     @default(0)
  catCSubconUnits Decimal @default(0) @db.Decimal(6, 1)

  // Workflow Sign-off metadata
  submittedById   String?   @db.Uuid
  submittedAt     DateTime? @db.Timestamptz
  approvedById    String?   @db.Uuid
  approvedAt      DateTime? @db.Timestamptz
  rejectionReason String?   @db.Text
  lockedById      String?   @db.Uuid
  lockedAt        DateTime? @db.Timestamptz

  version   Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  company     Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project     Project   @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Restrict)
  site        Site      @relation(fields: [siteId, companyId], references: [id, companyId], onDelete: Restrict)
  submittedBy Employee? @relation("DsrSubmittedBy", fields: [submittedById, companyId], references: [id, companyId], onDelete: SetNull)
  approvedBy  Employee? @relation("DsrApprovedBy", fields: [approvedById, companyId], references: [id, companyId], onDelete: SetNull)
  lockedBy    Employee? @relation("DsrLockedBy", fields: [lockedById, companyId], references: [id, companyId], onDelete: SetNull)

  labourSummaries DailySiteReportLabour[]
  auditLogs       DailyReportAuditLog[]

  @@unique([id, companyId])
  @@unique([companyId, siteId, businessDate])
  @@index([companyId, siteId, businessDate])
  @@index([companyId, status])
  @@index([companyId, businessDate])
}

model DailySiteReportLabour {
  id        String         @id @default(uuid()) @db.Uuid
  companyId String         @db.Uuid
  reportId  String         @db.Uuid
  category  LabourCategory

  // Specific Subcontractor or Department grouping
  subcontractorId   String? @db.Uuid
  subcontractorName String? @db.VarChar(150)
  tradeCategory     String  @db.VarChar(100)

  headcount     Int     @default(0)
  presentUnits  Decimal @default(0) @db.Decimal(6, 1)
  overtimeHours Decimal @default(0) @db.Decimal(6, 2)
  remarks       String? @db.VarChar(255)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  company Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  report  DailySiteReport @relation(fields: [reportId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([id, companyId])
  @@index([companyId, reportId])
  @@index([companyId, category])
}

model DailyReportAuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  reportId  String   @db.Uuid
  actorId   String   @db.Uuid
  action    String   @db.VarChar(60) // "CREATED", "AUTO_CALCULATED", "EDITED_HEADER", "REGULARIZED_SESSION", "APPROVED", "LOCKED", "REJECTED"
  fieldName String?  @db.VarChar(100)
  oldValue  String?  @db.Text
  newValue  String?  @db.Text
  reason    String   @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamptz

  company Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  report  DailySiteReport @relation(fields: [reportId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([id, companyId])
  @@index([companyId, reportId, createdAt])
}

// ---------------------------------------------------------------------------
// Leave Management (Milestone Phase 2)
// ---------------------------------------------------------------------------

enum LeaveType {
  CASUAL
  SICK
  PRIVILEGE
  COMP_OFF
  LOSS_OF_PAY
  SPECIAL
}

enum LeaveAccrualFrequency {
  ANNUAL
  MONTHLY
  QUARTERLY
  NONE
}

// Accrual rule kinds supported by LeavePolicyVersion. A mode picks which of
// the version's parameter columns apply — enforced by the lpv_mode_fields
// CHECK constraint and service validation.
enum LeaveAccrualMode {
  MONTHLY_CREDIT
  WORKED_DAYS_RATIO
  NONE
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum HalfDayPortion {
  FIRST_HALF
  SECOND_HALF
}

model LeavePolicy {
  id                   String                @id @default(uuid()) @db.Uuid
  companyId            String                @db.Uuid
  scopeType            AttendancePolicyScope @default(COMPANY)
  // DEPARTMENT-scoped policies reference the real Department record regardless
  // of where that department sits (HO / project / site). Location is not a
  // separate scope.
  departmentId         String?               @db.Uuid
  projectId            String?               @db.Uuid
  siteId               String?               @db.Uuid
  employeeId           String?               @db.Uuid
  // Administrator-defined leave type (new-style policies). NULL on rows that
  // predate dynamic types — those keep their leaveType enum value below.
  typeDefId            String?               @db.Uuid
  // Legacy enum key kept for pre-existing policies and request/balance gating.
  // NULL on policies for fully custom types with no enum counterpart.
  leaveType            LeaveType?
  name                 String
  description          String?
  annualAllowance      Decimal               @default(12) @db.Decimal(4, 1)
  accrualFrequency     LeaveAccrualFrequency @default(ANNUAL)
  maxConsecutiveDays   Int?
  minNoticeDays        Int                   @default(0)
  allowHalfDay         Boolean               @default(true)
  sandwichRule         Boolean               @default(false)
  carryoverMaxDays     Decimal               @default(0) @db.Decimal(4, 1)
  encashable           Boolean               @default(false)
  requiresDocAboveDays Int?
  isActive             Boolean               @default(true)
  version              Int                   @default(0)
  createdAt            DateTime              @default(now()) @db.Timestamptz
  updatedAt            DateTime              @updatedAt @db.Timestamptz

  company    Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  department Department?          @relation(fields: [departmentId, companyId], references: [id, companyId], onDelete: Restrict)
  project    Project?             @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Restrict)
  site       Site?                @relation(fields: [siteId, companyId], references: [id, companyId], onDelete: Restrict)
  employee   Employee?            @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)
  typeDef    LeaveTypeDef?        @relation(fields: [typeDefId, companyId], references: [id, companyId], onDelete: Restrict)
  versions   LeavePolicyVersion[]

  @@unique([id, companyId])
  @@index([companyId, scopeType, leaveType])
  @@index([companyId, departmentId])
  @@index([companyId, typeDefId])
  @@index([companyId, projectId])
  @@index([companyId, siteId])
  @@index([companyId, employeeId])
}

// Company-configured leave type vocabulary. Replaces the closed LeaveType
// enum for new policy authoring: administrators define types (Casual, Sick,
// Earned, Comp Off, Loss of Pay, or anything custom) with no built-in
// entitlement amounts. `leaveType` maps a definition back to a built-in enum
// value when one exists — backfilled definitions and any def the admin
// explicitly maps. NULL for fully custom types. ARCHIVED defs stay valid on
// existing policies but cannot be used for new ones.
model LeaveTypeDef {
  id          String        @id @default(uuid()) @db.Uuid
  companyId   String        @db.Uuid
  code        String // normalized, unique within the company
  name        String
  description String?
  leaveType   LeaveType?
  status      OrgNodeStatus @default(ACTIVE)
  version     Int           @default(0)
  createdAt   DateTime      @default(now()) @db.Timestamptz
  updatedAt   DateTime      @updatedAt @db.Timestamptz

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  policies LeavePolicy[]

  @@unique([companyId, code])
  // At most one def may map to a given built-in enum value per company
  // (multiple NULL rows allowed — custom types have no enum mapping).
  @@unique([companyId, leaveType])
  // Referenced by LeavePolicy's composite same-company FK.
  @@unique([id, companyId])
  @@index([companyId, status, id])
}

// Immutable, effective-dated accrual configuration for a LeavePolicy. Mirrors
// the WorkSchedule identity/revision split: the policy row holds scope +
// identity; every accrual-mode change is a new version row covering
// [effectiveFrom, next ACTIVE version's effectiveFrom). Past submissions
// always resolve against the version effective on their date — version rows
// are never updated, only appended or cancelled (status ARCHIVED, retained).
//
// Modes (all administrator-configured, no code changes):
//   - MONTHLY_CREDIT: monthlyCreditAmount days credited per month
//     (e.g. 4 => "4 days of Casual Leave per month").
//   - WORKED_DAYS_RATIO: whole-threshold credits only —
//     credits = floor((eligibleDays + residualDays) / ratioThresholdDays)
//             * ratioEarnedAmount; only the remainder carries forward
//     (e.g. threshold 20, earned 2 => "2 days Earned Leave per 20 worked days").
//   - NONE: type exists but accrues nothing automatically.
model LeavePolicyVersion {
  id                   String           @id @default(uuid()) @db.Uuid
  policyId             String           @db.Uuid
  companyId            String           @db.Uuid
  version              Int
  effectiveFrom        DateTime         @db.Date
  mode                 LeaveAccrualMode
  monthlyCreditAmount  Decimal?         @db.Decimal(4, 1)
  ratioThresholdDays   Int?
  ratioEarnedAmount    Decimal?         @db.Decimal(4, 1)
  status               OrgNodeStatus    @default(ACTIVE)
  note                 String?
  // Verbatim snapshot of the pre-versioning config for migrated legacy
  // policies — preserves their original fields losslessly.
  legacyConfig         Json?
  createdByPrincipalId String?          @db.Uuid
  createdAt            DateTime         @default(now()) @db.Timestamptz

  company Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  policy  LeavePolicy @relation(fields: [policyId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([policyId, version])
  @@index([policyId, effectiveFrom, version])
  @@index([companyId])
}

model LeaveBalance {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @db.Uuid
  employeeId      String    @db.Uuid
  leaveType       LeaveType
  year            Int
  allocatedDays   Decimal   @default(0) @db.Decimal(4, 1)
  usedDays        Decimal   @default(0) @db.Decimal(4, 1)
  pendingDays     Decimal   @default(0) @db.Decimal(4, 1)
  carriedOverDays Decimal   @default(0) @db.Decimal(4, 1)
  version         Int       @default(0)
  createdAt       DateTime  @default(now()) @db.Timestamptz
  updatedAt       DateTime  @updatedAt @db.Timestamptz

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([id, companyId])
  @@unique([companyId, employeeId, leaveType, year])
  @@index([companyId, employeeId])
}

model LeaveRequest {
  id             String             @id @default(uuid()) @db.Uuid
  companyId      String             @db.Uuid
  employeeId     String             @db.Uuid
  leaveType      LeaveType
  startDate      DateTime           @db.Date
  endDate        DateTime           @db.Date
  isHalfDay      Boolean            @default(false)
  halfDayPortion HalfDayPortion?
  totalDays      Decimal            @db.Decimal(4, 1)
  reason         String
  documentId     String?            @db.Uuid
  status         LeaveRequestStatus @default(PENDING)
  reviewedBy     String?            @db.Uuid
  reviewedAt     DateTime?          @db.Timestamptz
  reviewRemarks  String?
  version        Int                @default(0)
  createdAt      DateTime           @default(now()) @db.Timestamptz
  updatedAt      DateTime           @updatedAt @db.Timestamptz

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([id, companyId])
  @@index([companyId, employeeId, status])
  @@index([companyId, startDate, endDate])
}

// ---------------------------------------------------------------------------
// Safety Toolbox Talk (TVT) Gate (Milestone Phase 3)
// ---------------------------------------------------------------------------

model SafetyTvtSession {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  siteId       String   @db.Uuid
  businessDate String   @db.VarChar(10) // YYYY-MM-DD
  topic        String
  conductedAt  DateTime @default(now()) @db.Timestamptz
  conductedBy  String   @db.Uuid // Employee ID / Supervisor
  remarks      String?
  version      Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  company   Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  site      Site                @relation(fields: [siteId, companyId], references: [id, companyId], onDelete: Restrict)
  attendees SafetyTvtAttendee[]

  @@unique([id, companyId])
  @@index([companyId, siteId, businessDate])
}

model SafetyTvtAttendee {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @db.Uuid
  sessionId  String   @db.Uuid
  employeeId String   @db.Uuid
  attendedAt DateTime @default(now()) @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  session  SafetyTvtSession @relation(fields: [sessionId, companyId], references: [id, companyId], onDelete: Cascade)
  employee Employee         @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([id, companyId])
  @@unique([sessionId, employeeId])
  @@index([companyId, employeeId])
}

// ---------------------------------------------------------------------------
// Work Schedules & Holiday Calendars (Milestone: dynamic attendance foundation)
// ---------------------------------------------------------------------------

// Disposition of a date-specific schedule override: force the date WORKING or
// OFF regardless of the pattern evaluation.
enum ScheduleOverrideKind {
  WORKING
  OFF
}

// Company-owned reusable holiday calendar. Assigned to scopes exclusively via
// WorkScheduleRevision — the schedule is the single source of truth for "which
// holidays apply to whom". No entitlement or statutory content lives here.
model HolidayCalendar {
  id          String        @id @default(uuid()) @db.Uuid
  companyId   String        @db.Uuid
  code        String // normalized, unique within the company
  name        String
  description String?
  status      OrgNodeStatus @default(ACTIVE)
  version     Int           @default(0)
  createdAt   DateTime      @default(now()) @db.Timestamptz
  updatedAt   DateTime      @updatedAt @db.Timestamptz

  company   Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  holidays  Holiday[]
  revisions WorkScheduleRevision[]

  @@unique([companyId, code])
  // Referenced by Holiday's and WorkScheduleRevision's composite FKs.
  @@unique([id, companyId])
  @@index([companyId, status, id])
}

// Administrator-defined holiday category vocabulary. Categories are pure
// labels — they carry no entitlement or legal meaning — and are fully
// company-configured (no seeded set). ARCHIVED categories stay valid on
// existing holidays but cannot be used for new ones.
model HolidayCategory {
  id          String        @id @default(uuid()) @db.Uuid
  companyId   String        @db.Uuid
  code        String // normalized, unique within the company
  name        String
  description String?
  status      OrgNodeStatus @default(ACTIVE)
  version     Int           @default(0)
  createdAt   DateTime      @default(now()) @db.Timestamptz
  updatedAt   DateTime      @updatedAt @db.Timestamptz

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  holidays Holiday[]

  @@unique([companyId, code])
  // Referenced by Holiday's composite same-company FK.
  @@unique([id, companyId])
  @@index([companyId, status, id])
}

model Holiday {
  id          String        @id @default(uuid()) @db.Uuid
  companyId   String        @db.Uuid
  calendarId  String        @db.Uuid
  date        DateTime      @db.Date
  name        String
  categoryId  String        @db.Uuid
  // ARCHIVED = cancelled: the row is retained for audit/history and no longer
  // counts in classification. Only one ACTIVE holiday per (calendarId, date) —
  // enforced by a partial unique index in migration SQL.
  status      OrgNodeStatus @default(ACTIVE)
  cancelledAt DateTime?     @db.Timestamptz
  createdAt   DateTime      @default(now()) @db.Timestamptz
  updatedAt   DateTime      @updatedAt @db.Timestamptz

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  calendar HolidayCalendar @relation(fields: [calendarId, companyId], references: [id, companyId], onDelete: Restrict)
  category HolidayCategory @relation(fields: [categoryId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([companyId, calendarId, date])
  @@index([companyId, categoryId])
}

// Effective-dated work schedule identity for a company / department / project /
// site / employee target. Scope shape is enforced in the service: exactly the
// scope's own reference column is populated. DEPARTMENT references the real
// Department record regardless of where that department is located (HO vs
// project/site). effectiveFrom/effectiveTo bound the whole schedule's validity
// window; overlap of ACTIVE schedules at the same target is prevented by the
// work_schedule_no_overlap exclusion constraint (migration SQL). The working
// pattern itself lives in immutable WorkScheduleRevision rows — past dates
// always resolve against the revision effective on that date.
model WorkSchedule {
  id            String                @id @default(uuid()) @db.Uuid
  companyId     String                @db.Uuid
  scopeType     AttendancePolicyScope @default(COMPANY)
  departmentId  String?               @db.Uuid
  projectId     String?               @db.Uuid
  siteId        String?               @db.Uuid
  employeeId    String?               @db.Uuid
  name          String
  description   String?
  effectiveFrom DateTime              @db.Date
  effectiveTo   DateTime?             @db.Date // inclusive; NULL = open-ended
  status        OrgNodeStatus         @default(ACTIVE)
  // Set when the schedule is archived. Resolution treats the schedule as
  // applicable for asOf < archivedAt so archiving never rewrites the
  // classification of already-past dates.
  archivedAt    DateTime?             @db.Timestamptz
  version       Int                   @default(0)
  createdAt     DateTime              @default(now()) @db.Timestamptz
  updatedAt     DateTime              @updatedAt @db.Timestamptz

  company    Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  department Department?            @relation(fields: [departmentId, companyId], references: [id, companyId], onDelete: Restrict)
  project    Project?               @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Restrict)
  site       Site?                  @relation(fields: [siteId, companyId], references: [id, companyId], onDelete: Restrict)
  employee   Employee?              @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)
  revisions  WorkScheduleRevision[]
  overrides  WorkScheduleOverride[]

  @@unique([id, companyId])
  @@index([companyId, scopeType])
  @@index([companyId, departmentId])
  @@index([companyId, projectId])
  @@index([companyId, siteId])
  @@index([companyId, employeeId])
}

// Immutable, append-only pattern version of a WorkSchedule. A revision covers
// [effectiveFrom, next ACTIVE revision's effectiveFrom); a same-date tie is
// broken by the higher revision number. Configuration columns never update —
// corrections are made by adding a new revision or cancelling a mistaken one.
// Pattern model (all administrator-configurable, no code changes needed):
//   - workingWeekdays: ISO weekday numbers 0 (Sun) .. 6 (Sat). May be EMPTY
//     only when rotationWorkingOffsets defines a pure rotating cycle.
//   - offNthWeekdays: JSON [{weekday: 0..6, nths: [-1,1..5]}] — monthly
//     positional offs, e.g. [{weekday:6, nths:[2,4]}] = 2nd & 4th Saturdays;
//     -1 means the last occurrence of that weekday in the month.
//   - rotation*: continuous cycle anchored to rotationAnchor —
//     (date - anchor) mod rotationLengthDays gives the cycle offset;
//     rotationWorkingOffsets force WORKING, rotationOffOffsets force OFF
//     (and win over working sources). Covers N-on/M-off rosters and any
//     fixed-length alternate-week pattern.
model WorkScheduleRevision {
  id                     String        @id @default(uuid()) @db.Uuid
  scheduleId             String        @db.Uuid
  companyId              String        @db.Uuid
  revision               Int
  effectiveFrom          DateTime      @db.Date
  timezone               String
  workingWeekdays        Int[]
  offNthWeekdays         Json? // validated array shape, see comment above
  rotationAnchor         DateTime?     @db.Date
  rotationLengthDays     Int?
  rotationWorkingOffsets Int[]
  rotationOffOffsets     Int[]
  holidayCalendarId      String?       @db.Uuid
  // Intraday shift timing — minutes since local midnight in `timezone`.
  // scheduledEndMins < scheduledStartMins encodes an overnight shift.
  // All nullable: a revision without them is a day-pattern only and the
  // legacy AttendancePolicy thresholds govern exactly as before.
  scheduledStartMins   Int?
  scheduledEndMins     Int?
  graceInMins          Int?
  graceOutMins         Int?
  // Break behavior. FIXED_WINDOW requires breakWindowStartMins/EndMins +
  // breakDurationMins; the duration is deducted without break punches.
  // DYNAMIC keeps punch-recorded breaks bounded by the optional window and
  // breakDurationMins as the per-day maximum deduction.
  breakWindowMode      BreakWindowMode?
  breakWindowStartMins Int?
  breakWindowEndMins   Int?
  breakDurationMins    Int?
  // Scheduled clock-out. AFTER_GRACE requires autoClockOutGraceMins > 0;
  // AT_SCHEDULED_END forbids it (grace must not delay the close).
  autoClockOutMode      AutoClockOutMode?
  autoClockOutGraceMins Int?
  // CANCELLED revisions are retained for audit but never applied.
  status                 OrgNodeStatus @default(ACTIVE)
  note                   String?
  createdByPrincipalId   String?       @db.Uuid
  createdAt              DateTime      @default(now()) @db.Timestamptz

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  schedule        WorkSchedule     @relation(fields: [scheduleId, companyId], references: [id, companyId], onDelete: Restrict)
  holidayCalendar HolidayCalendar? @relation(fields: [holidayCalendarId, companyId], references: [id, companyId], onDelete: Restrict)
  sessions        AttendanceSession[]

  @@unique([id, companyId])
  @@unique([scheduleId, revision])
  @@index([scheduleId, effectiveFrom, revision])
  @@index([companyId, holidayCalendarId])
}

// Date-specific override on a schedule: a declared working day or off day that
// beats every other classification input for that date. ARCHIVED = cancelled;
// one ACTIVE override per (scheduleId, date) via partial unique index.
model WorkScheduleOverride {
  id                   String               @id @default(uuid()) @db.Uuid
  scheduleId           String               @db.Uuid
  companyId            String               @db.Uuid
  date                 DateTime             @db.Date
  disposition          ScheduleOverrideKind
  name                 String?
  status               OrgNodeStatus        @default(ACTIVE)
  cancelledAt          DateTime?            @db.Timestamptz
  createdByPrincipalId String?              @db.Uuid
  createdAt            DateTime             @default(now()) @db.Timestamptz
  updatedAt            DateTime             @updatedAt @db.Timestamptz

  company  Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  schedule WorkSchedule @relation(fields: [scheduleId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([companyId, scheduleId, date])
}

// ---------------------------------------------------------------------------
// Finance — Project Budgets & Cash-Flow Forecasts
// ---------------------------------------------------------------------------
// Money is Decimal(18,2) — never floating point. Budget revisions are
// append-only (submit/decide transitions only — no PATCH). Forecasts are
// mutable documents with optimistic concurrency; their revision counter
// increments on each revise for auditability.
// "Costs" reads are derived from APPROVED revisions + forecasts only —
// no Finance transaction ledger exists yet, so actuals are never fabricated.

enum BudgetRevisionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  RETURNED
}

enum BudgetCategory {
  MATERIAL
  LABOUR
  EQUIPMENT
  SUBCONTRACT
  OVERHEAD
  CONTINGENCY
  OTHER
}

enum BudgetReviewAction {
  APPROVE
  REJECT
  RETURN
}

enum CashFlowDirection {
  INFLOW
  OUTFLOW
}

enum CashFlowCategory {
  CLIENT_RECEIPT
  ADVANCE_RECEIPT
  RETENTION_RELEASE
  MATERIAL
  LABOUR
  EQUIPMENT
  SUBCONTRACT
  OVERHEAD
  TAX
  OTHER
}

// Identity record for a project budget. The authoritative money content
// lives in immutable BudgetRevision rows; latestApprovedRevisionId is a
// back-pointer set only by an APPROVE decision.
model ProjectBudget {
  id                       String        @id @default(uuid()) @db.Uuid
  companyId                String        @db.Uuid
  projectId                String        @db.Uuid
  code                     String // normalized, unique per project
  name                     String
  description              String?
  currency                 String        @db.VarChar(3) // ISO 4217
  status                   OrgNodeStatus @default(ACTIVE)
  latestApprovedRevisionId String?       @db.Uuid
  idempotencyKey           String?
  requestFingerprint       String? // sha256 of the semantic command
  version                  Int           @default(0)
  createdAt                DateTime      @default(now()) @db.Timestamptz
  updatedAt                DateTime      @updatedAt @db.Timestamptz

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project   Project          @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Restrict)
  revisions BudgetRevision[]

  // latestApprovedRevisionId has NO Prisma relation — its composite FK
  // (latestApprovedRevisionId, id, companyId) → BudgetRevision(id, budgetId,
  // companyId) is hand-added in the migration, guaranteeing the pointer can
  // only name a revision of this budget in this company.
  @@unique([companyId, projectId, code])
  // Referenced by BudgetRevision's composite FK (budgetId, companyId).
  @@unique([id, companyId])
  // Project-scoped budget lists: WHERE companyId = ? AND projectId = ? [AND status = ?].
  @@index([companyId, projectId, status, id])
}

// Immutable budget content: lines are inserted once with the revision;
// the row itself only ever moves through the review state machine.
model BudgetRevision {
  id                     String               @id @default(uuid()) @db.Uuid
  companyId              String               @db.Uuid
  budgetId               String               @db.Uuid
  revision               Int // strictly increasing per budget
  status                 BudgetRevisionStatus @default(DRAFT)
  totalAmount            Decimal              @default(0) @db.Decimal(18, 2)
  notes                  String?
  submittedByPrincipalId String?              @db.Uuid
  submittedAt            DateTime?            @db.Timestamptz
  decidedByPrincipalId   String?              @db.Uuid
  decidedAt              DateTime?            @db.Timestamptz
  idempotencyKey         String?
  requestFingerprint     String? // sha256 of the semantic command
  version                Int                  @default(0)
  createdAt              DateTime             @default(now()) @db.Timestamptz
  updatedAt              DateTime             @updatedAt @db.Timestamptz

  company     Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  budget      ProjectBudget          @relation(fields: [budgetId, companyId], references: [id, companyId], onDelete: Restrict)
  submittedBy Principal?             @relation("BudgetRevisionSubmitter", fields: [submittedByPrincipalId], references: [id], onDelete: Restrict)
  decidedBy   Principal?             @relation("BudgetRevisionDecider", fields: [decidedByPrincipalId], references: [id], onDelete: Restrict)
  lines       BudgetRevisionLine[]
  decisions   BudgetReviewDecision[]

  @@unique([companyId, budgetId, revision])
  // Referenced by BudgetRevisionLine/BudgetReviewDecision composite FKs.
  @@unique([id, companyId])
  // Referenced by ProjectBudget's (latestApprovedRevisionId, id, companyId)
  // composite FK: the pointer can only name a revision of this budget.
  @@unique([id, budgetId, companyId])
  // Revision inbox per budget (+status).
  @@index([companyId, budgetId, status, id])
}

// One immutable line of a budget revision — no update/delete paths.
model BudgetRevisionLine {
  id          String         @id @default(uuid()) @db.Uuid
  companyId   String         @db.Uuid
  revisionId  String         @db.Uuid
  category    BudgetCategory
  description String
  amount      Decimal        @db.Decimal(18, 2)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now()) @db.Timestamptz

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  revision BudgetRevision @relation(fields: [revisionId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([companyId, revisionId, sortOrder, id])
}

// Append-only review outcome — exactly the decisions applied to a revision.
model BudgetReviewDecision {
  id                 String             @id @default(uuid()) @db.Uuid
  companyId          String             @db.Uuid
  revisionId         String             @db.Uuid
  action             BudgetReviewAction
  actorPrincipalId   String?            @db.Uuid
  actorType          String
  reason             String?
  idempotencyKey     String?
  requestFingerprint String?
  eventKey           String             @unique @db.Uuid
  decidedAt          DateTime           @default(now()) @db.Timestamptz
  createdAt          DateTime           @default(now()) @db.Timestamptz

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  revision BudgetRevision @relation(fields: [revisionId, companyId], references: [id, companyId], onDelete: Restrict)
  actor    Principal?     @relation(fields: [actorPrincipalId], references: [id], onDelete: Restrict)

  // Decision history for a revision.
  @@index([companyId, revisionId, decidedAt, id])
}

// Planning document: expected receipts/spend over an effective period.
// Header + lines are replaced atomically on revise (version-guarded);
// `revision` counts those edits for readability of audit history.
model CashFlowForecast {
  id                 String        @id @default(uuid()) @db.Uuid
  companyId          String        @db.Uuid
  projectId          String        @db.Uuid
  name               String
  description        String?
  currency           String        @db.VarChar(3)
  periodStart        DateTime      @db.Date
  periodEnd          DateTime      @db.Date
  status             OrgNodeStatus @default(ACTIVE)
  revision           Int           @default(1)
  idempotencyKey     String?
  requestFingerprint String?
  version            Int           @default(0)
  createdAt          DateTime      @default(now()) @db.Timestamptz
  updatedAt          DateTime      @updatedAt @db.Timestamptz

  company Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project Project                @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Restrict)
  lines   CashFlowForecastLine[]

  @@unique([id, companyId])
  // Project-scoped forecast lists (+status).
  @@index([companyId, projectId, status, id])
  // Overlap/period queries: WHERE companyId = ? AND projectId = ? AND periodStart <= ? AND periodEnd >= ?.
  @@index([companyId, projectId, periodStart, periodEnd])
}

model CashFlowForecastLine {
  id           String            @id @default(uuid()) @db.Uuid
  companyId    String            @db.Uuid
  forecastId   String            @db.Uuid
  direction    CashFlowDirection
  category     CashFlowCategory
  amount       Decimal           @db.Decimal(18, 2)
  expectedDate DateTime?         @db.Date
  description  String?
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now()) @db.Timestamptz

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  forecast CashFlowForecast @relation(fields: [forecastId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([companyId, forecastId, sortOrder, id])
}

// ---------------------------------------------------------------------------
// Company-controlled delegation switches for scoped project/site
// administration (PI/PD). Every flag defaults OFF — a missing row means
// nothing is delegated. Versioned for optimistic concurrency.
// ---------------------------------------------------------------------------
model CompanyDelegationPolicy {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @unique @db.Uuid
  // PI/PD (or other scoped holders) may create sites under their projects.
  siteCreate      Boolean  @default(false)
  // Scoped holders may update site details/status under their projects.
  siteUpdate      Boolean  @default(false)
  // Scoped holders may create/update/transition project- and site-scoped
  // departments. Company and Head Office departments are never delegated.
  deptManage      Boolean  @default(false)
  // Scoped holders may place employees in project/site departments — add,
  // update, end, and transfer memberships inside their assigned scope only.
  placement       Boolean  @default(false)
  // Scoped holders may onboard workforce profiles (no login, no invite) into
  // project/site departments inside their assigned scope only.
  employeeOnboard Boolean  @default(false)
  // Scoped holders may suspend and reinstate workforce at their assigned
  // projects/sites — ends in-scope memberships; never touches out-of-scope
  // rows, Employee.status, or Principal.status.
  memberSuspend   Boolean  @default(false)
  // Scoped holders may permanently exit workforce at their assigned
  // projects/sites — a stronger, separately delegated authority.
  memberExit      Boolean  @default(false)
  // Scoped holders may create/revise SITE- or PROJECT-scoped work schedules
  // (intraday shift times, break windows, auto clock-out). Schedule-policy
  // editing is a separate authority from attendance-record management and
  // stays company/Finance unless this flag is on.
  scheduleManage  Boolean  @default(false)
  version         Int      @default(0)
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
}

// ---------------------------------------------------------------------------
// Site Wallet & Finance Funding — schema + invariants only (Slice 1).
// One imprest-style wallet per site. Balance changes ONLY through append-only
// ledger entries posted atomically with their source row (transfer/expense/
// reversal). Approval never moves money; a transfer's confirmed amount is the
// only credit path. Money columns are exact Decimal(18,2); currency is fixed
// per wallet and never converted.
// ---------------------------------------------------------------------------

enum SiteWalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

// Request-level envelope state. SUBMITTED covers the whole review period —
// there is deliberately no separate IN_REVIEW state.
enum WalletFundingRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  RETURNED
  PARTIALLY_FUNDED
  FUNDED
  CLOSED_SHORT
  CANCELLED
}

enum WalletFundingAttemptStatus {
  SUBMITTED
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
}

enum WalletTransferStatus {
  RECORDED
  CONFIRMED
  DISPUTED
  CLOSED
  REVERSED
}

enum WalletExpenseStatus {
  POSTED
  REVERSED
}

enum WalletEvidenceState {
  NONE
  ATTACHED
}

// Sign lives on the type, not the amount: CREDIT_* rows add to the wallet
// balance, DEBIT_* rows subtract. REVERSAL_DEBIT undoes a funding credit;
// REVERSAL_CREDIT undoes an expense debit.
enum WalletLedgerType {
  CREDIT_FUNDING
  DEBIT_EXPENSE
  REVERSAL_DEBIT
  REVERSAL_CREDIT
}

model SiteWallet {
  id        String           @id @default(uuid()) @db.Uuid
  companyId String           @db.Uuid
  siteId    String           @db.Uuid
  currency  String           @db.VarChar(3) // fixed at creation — never mutated, never converted
  balance   Decimal          @default(0) @db.Decimal(18, 2) // CHECK >= 0 in migration
  status    SiteWalletStatus @default(ACTIVE)
  version   Int              @default(0)
  createdAt DateTime         @default(now()) @db.Timestamptz
  updatedAt DateTime         @updatedAt @db.Timestamptz

  company          Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  site             Site                    @relation(fields: [siteId, companyId], references: [id, companyId], onDelete: Restrict)
  fundingRequests  WalletFundingRequest[]
  transfers        WalletTransfer[]
  expenses         WalletExpense[]
  cashVouchers     WalletCashVoucher[]
  reversalRequests WalletReversalRequest[]
  ledgerEntries    WalletLedgerEntry[]

  // One wallet per site — (siteId, companyId) unique satisfies the 1:1
  // relation; a second row can never pair a site with another company
  // because the (siteId, companyId) → Site composite FK binds the pairing.
  @@unique([siteId, companyId])
  // Referenced by composite FKs elsewhere.
  @@unique([id, companyId])
  // Binds dependents' siteId to this wallet's site: FK (walletId, companyId,
  // siteId) → (id, companyId, siteId) makes cross-site references impossible.
  @@unique([id, companyId, siteId])
  @@index([companyId, status])
}

// Durable funding envelope — PI asks Finance for a site-wallet top-up.
// Approval state history lives in immutable attempts; funding progress lives
// here so reporting never has to re-derive it.
model WalletFundingRequest {
  id                     String                     @id @default(uuid()) @db.Uuid
  companyId              String                     @db.Uuid
  walletId               String                     @db.Uuid
  siteId                 String                     @db.Uuid // bound to wallet.site via composite FK below
  requestedByPrincipalId String                     @db.Uuid
  requestedByEmployeeId  String                     @db.Uuid
  status                 WalletFundingRequestStatus @default(DRAFT)
  // Editable draft fields — snapshotted into an immutable
  // WalletFundingAttempt at each submit; null once the request is terminal.
  draftAmount            Decimal?                   @db.Decimal(18, 2)
  draftPurpose           String?                    @db.VarChar(500)
  draftNeededByDate      DateTime?                  @db.Date
  approvedAmount         Decimal?                   @db.Decimal(18, 2) // set by the latest APPROVED attempt
  confirmedAmount        Decimal                    @default(0) @db.Decimal(18, 2) // Σ confirmed receipts; CHECK <= approvedAmount
  // Pointer to the current attempt only — full history is on
  // WalletFundingAttempt; no workflowInstanceId is stored or overwritten here.
  currentAttemptId       String?                    @db.Uuid
  closedShortReason      String?
  idempotencyKey         String                     @db.VarChar(80) // required — create replays by key
  version                Int                        @default(0)
  createdAt              DateTime                   @default(now()) @db.Timestamptz
  updatedAt              DateTime                   @updatedAt @db.Timestamptz

  company             Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  // (walletId, companyId, siteId) → SiteWallet pins request.siteId to the
  // wallet's own site — a request can never point at another site's wallet.
  wallet              SiteWallet             @relation(fields: [walletId, companyId, siteId], references: [id, companyId, siteId], onDelete: Restrict)
  site                Site                   @relation(fields: [siteId, companyId], references: [id, companyId], onDelete: Restrict)
  requestedBy         Principal              @relation("WalletFundingRequester", fields: [requestedByPrincipalId], references: [id], onDelete: Restrict)
  requestedByEmployee Employee               @relation(fields: [requestedByEmployeeId, companyId], references: [id, companyId], onDelete: Restrict)
  attempts            WalletFundingAttempt[]
  transfers           WalletTransfer[]
  ledgerEntries       WalletLedgerEntry[]
  documentLinks       DocumentLink[]

  // Retry-safe create: one row per (requester, idempotencyKey).
  @@unique([companyId, requestedByPrincipalId, idempotencyKey])
  // Referenced by composite FKs elsewhere.
  @@unique([id, companyId])
  // Binds transfers' siteId to this request's site.
  @@unique([id, companyId, siteId])
  // Binds ledger-entry provenance to this request's wallet.
  @@unique([id, walletId, companyId])
  @@index([companyId, siteId, status, id])
  @@index([companyId, status, id])
}

// One immutable row per submission attempt. A RETURN lets the PI edit the
// envelope and resubmit — the new attempt gets its own workflow instance and
// the full decision history is preserved forever.
model WalletFundingAttempt {
  id                     String                     @id @default(uuid()) @db.Uuid
  companyId              String                     @db.Uuid
  requestId              String                     @db.Uuid
  attemptNo              Int
  amount                 Decimal                    @db.Decimal(18, 2) // CHECK > 0
  currency               String                     @db.VarChar(3)
  purpose                String                     @db.VarChar(500)
  neededByDate           DateTime?                  @db.Date
  // Exactly one workflow instance per attempt — never reused, never
  // overwritten (unique below).
  workflowInstanceId     String                     @db.Uuid
  approvalTaskId         String?                    @db.Uuid
  status                 WalletFundingAttemptStatus @default(SUBMITTED)
  approvedAmount         Decimal?                   @db.Decimal(18, 2)
  decidedByPrincipalId   String?                    @db.Uuid
  decidedAt              DateTime?                  @db.Timestamptz
  decisionReason         String?
  submittedByPrincipalId String                     @db.Uuid
  idempotencyKey         String                     @db.VarChar(80) // required — submit replays by key
  submittedAt            DateTime                   @default(now()) @db.Timestamptz
  createdAt              DateTime                   @default(now()) @db.Timestamptz
  updatedAt              DateTime                   @updatedAt @db.Timestamptz

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  request     WalletFundingRequest @relation(fields: [requestId, companyId], references: [id, companyId], onDelete: Restrict)
  instance    WorkflowInstance     @relation(fields: [workflowInstanceId, companyId], references: [id, companyId], onDelete: Restrict)
  submittedBy Principal            @relation("WalletFundingSubmitter", fields: [submittedByPrincipalId], references: [id], onDelete: Restrict)
  decidedBy   Principal?           @relation("WalletFundingDecider", fields: [decidedByPrincipalId], references: [id], onDelete: Restrict)
  transfers   WalletTransfer[]

  @@unique([requestId, attemptNo])
  @@unique([workflowInstanceId])
  // Retry-safe submit: one attempt row per (request, idempotencyKey).
  @@unique([companyId, requestId, idempotencyKey])
  // Referenced by composite FKs elsewhere.
  @@unique([id, companyId])
  // Binds transfers' requestId to this attempt's request.
  @@unique([id, companyId, requestId])
  @@index([companyId, requestId])
  @@index([companyId, status, id])
}

// Finance's record of money actually transferred against an approved
// attempt. Transferred ≠ credited — only PI-confirmed receipts post credits.
model WalletTransfer {
  id                     String               @id @default(uuid()) @db.Uuid
  companyId              String               @db.Uuid
  requestId              String               @db.Uuid
  attemptId              String               @db.Uuid
  walletId               String               @db.Uuid
  siteId                 String               @db.Uuid // bound to wallet.site AND request.site via composite FKs
  amount                 Decimal              @db.Decimal(18, 2) // CHECK > 0
  currency               String               @db.VarChar(3)
  reference              String               @db.VarChar(120) // UTR / voucher / cheque ref — required
  transferredAt          DateTime             @db.Timestamptz
  recordedByPrincipalId  String               @db.Uuid
  confirmedAmount        Decimal              @default(0) @db.Decimal(18, 2) // CHECK <= amount
  confirmedByPrincipalId String?              @db.Uuid
  confirmedAt            DateTime?            @db.Timestamptz
  discrepancyAmount      Decimal?             @db.Decimal(18, 2) // amount − confirmedAmount when disputed
  discrepancyNote        String? // audit only — never in notifications
  disputeResolution      String? // Finance resolution note — audit only
  status                 WalletTransferStatus @default(RECORDED)
  idempotencyKey         String               @db.VarChar(80) // required
  version                Int                  @default(0)
  createdAt              DateTime             @default(now()) @db.Timestamptz
  updatedAt              DateTime             @updatedAt @db.Timestamptz

  company       Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  site          Site                 @relation(fields: [siteId, companyId], references: [id, companyId], onDelete: Restrict)
  // Three-tuple bindings — site/request/attempt/wallet can never disagree:
  wallet        SiteWallet           @relation(fields: [walletId, companyId, siteId], references: [id, companyId, siteId], onDelete: Restrict)
  request       WalletFundingRequest @relation(fields: [requestId, companyId, siteId], references: [id, companyId, siteId], onDelete: Restrict)
  attempt       WalletFundingAttempt @relation(fields: [attemptId, companyId, requestId], references: [id, companyId, requestId], onDelete: Restrict)
  recordedBy    Principal            @relation("WalletTransferRecorder", fields: [recordedByPrincipalId], references: [id], onDelete: Restrict)
  confirmedBy   Principal?           @relation("WalletTransferConfirmer", fields: [confirmedByPrincipalId], references: [id], onDelete: Restrict)
  ledgerEntries WalletLedgerEntry[]
  documentLinks DocumentLink[]

  // The same transfer reference cannot be recorded twice on one request.
  @@unique([companyId, requestId, reference])
  // Retry-safe record: one row per (recorder, idempotencyKey).
  @@unique([companyId, recordedByPrincipalId, idempotencyKey])
  // Referenced by composite FKs elsewhere.
  @@unique([id, companyId])
  // Binds ledger CREDIT_FUNDING entries to this transfer's wallet.
  @@unique([id, walletId, companyId])
  @@index([companyId, walletId, status, id])
  @@index([companyId, requestId])
}

// Site expense — an immediate wallet debit in v1 (imprest model; PI is the
// accountable spender). Corrections are reversal entries, never edits.
model WalletExpense {
  id                   String              @id @default(uuid()) @db.Uuid
  companyId            String              @db.Uuid
  walletId             String              @db.Uuid
  amount               Decimal             @db.Decimal(18, 2) // CHECK > 0
  currency             String              @db.VarChar(3)
  expenseDate          DateTime            @db.Date
  category             String              @db.VarChar(40)
  description          String              @db.VarChar(500)
  payee                String?             @db.VarChar(200)
  reference            String?             @db.VarChar(120)
  status               WalletExpenseStatus @default(POSTED)
  evidenceState        WalletEvidenceState @default(NONE)
  // Provenance pointer to the DEBIT_EXPENSE ledger row. Plain column, not a
  // relation — the DB-level link direction is WalletLedgerEntry.expenseId →
  // this row, and a circular FK pair adds no integrity here.
  ledgerEntryId        String              @db.Uuid
  createdByPrincipalId String              @db.Uuid
  idempotencyKey       String              @db.VarChar(80) // required
  createdAt            DateTime            @default(now()) @db.Timestamptz

  company       Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  wallet        SiteWallet          @relation(fields: [walletId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy     Principal           @relation("WalletExpenseCreator", fields: [createdByPrincipalId], references: [id], onDelete: Restrict)
  ledgerEntries WalletLedgerEntry[]
  documentLinks DocumentLink[]
  cashVoucher   WalletCashVoucher?

  // Retry-safe create: one expense per (creator, idempotencyKey).
  @@unique([companyId, createdByPrincipalId, idempotencyKey])
  // Referenced by composite FKs elsewhere.
  @@unique([id, companyId])
  // Binds ledger DEBIT_EXPENSE entries to this expense's wallet.
  @@unique([id, walletId, companyId])
  @@index([companyId, walletId, expenseDate, id])
}

// Append-only money movement. Rows are never updated or deleted (immutable
// trigger in migration); corrections are new REVERSAL_* rows pointing back.
// balanceAfter is computed under the wallet row lock — invariant:
// wallet.balance == balanceAfter of the latest entry.
model WalletLedgerEntry {
  id                  String           @id @default(uuid()) @db.Uuid
  // Strict append order — "latest entry" and balanceAfter chaining are
  // defined on seq, not on clock time.
  seq                 BigInt           @default(autoincrement())
  companyId           String           @db.Uuid
  walletId            String           @db.Uuid
  type                WalletLedgerType
  amount              Decimal          @db.Decimal(18, 2) // always positive — sign carried by type; CHECK > 0
  currency            String           @db.VarChar(3)
  balanceAfter        Decimal          @db.Decimal(18, 2) // CHECK >= 0
  fundingRequestId    String?          @db.Uuid // provenance on CREDIT_FUNDING
  transferId          String?          @db.Uuid // set only on CREDIT_FUNDING
  expenseId           String?          @db.Uuid // set only on DEBIT_EXPENSE
  reversalOfEntryId   String?          @db.Uuid // set only on REVERSAL_* — same wallet/company via composite FK
  reason              String? // reversal reason — audit only
  postedByPrincipalId String           @db.Uuid
  idempotencyKey      String           @db.VarChar(80) // required
  postedAt            DateTime         @default(now()) @db.Timestamptz
  // No updatedAt — entries are immutable.

  company                Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  wallet                 SiteWallet              @relation(fields: [walletId, companyId], references: [id, companyId], onDelete: Restrict)
  // Three-tuple bindings pin each source record to THIS wallet — a credit can
  // never cite a transfer recorded against a different wallet, likewise for
  // expenses and funding-request provenance.
  fundingRequest         WalletFundingRequest?   @relation(fields: [fundingRequestId, walletId, companyId], references: [id, walletId, companyId], onDelete: Restrict)
  transfer               WalletTransfer?         @relation(fields: [transferId, walletId, companyId], references: [id, walletId, companyId], onDelete: Restrict)
  expense                WalletExpense?          @relation(fields: [expenseId, walletId, companyId], references: [id, walletId, companyId], onDelete: Restrict)
  // (reversalOfEntryId, walletId, companyId) → self pins the reversed entry
  // to the SAME wallet and company — cross-wallet reversals are impossible.
  reversalOf             WalletLedgerEntry?      @relation("WalletLedgerReversal", fields: [reversalOfEntryId, walletId, companyId], references: [id, walletId, companyId], onDelete: Restrict)
  reversedBy             WalletLedgerEntry[]     @relation("WalletLedgerReversal")
  reversalRequests       WalletReversalRequest[] @relation("WalletReversalTarget")
  reversalRequestResults WalletReversalRequest[] @relation("WalletReversalResult")
  documentLinks          DocumentLink[]
  postedBy               Principal               @relation("WalletLedgerPoster", fields: [postedByPrincipalId], references: [id], onDelete: Restrict)

  // Referenced by composite FKs elsewhere.
  @@unique([id, companyId])
  @@unique([id, walletId, companyId])
  // v1 rule: at most one reversal per entry — NULLs are distinct in Postgres,
  // so a plain unique index gives "one reversal, many non-reversals".
  @@unique([reversalOfEntryId])
  // Retry-safe post: one entry per (wallet, idempotencyKey).
  @@unique([companyId, walletId, idempotencyKey])
  @@index([companyId, walletId, postedAt, id])
  @@index([companyId, fundingRequestId])
  // "Latest entry on wallet" lookups used by the balance-chain trigger.
  @@index([walletId, seq])
}

// ---------------------------------------------------------------------------
// Site Wallet — Slice 2 runtime models (account heads, vouchers, reversals).
// ---------------------------------------------------------------------------

enum WalletAccountHeadStatus {
  ACTIVE
  INACTIVE
}

enum WalletReversalRequestStatus {
  REQUESTED
  EXECUTED
  REJECTED
}

// Company-managed account catalogue for cash-voucher lines — never seeded
// with fictional heads; Finance configures codes/names per company.
model WalletAccountHead {
  id        String                  @id @default(uuid()) @db.Uuid
  companyId String                  @db.Uuid
  code      String                  @db.VarChar(20) // client-owned code, unique per company
  name      String                  @db.VarChar(120)
  status    WalletAccountHeadStatus @default(ACTIVE)
  version   Int                     @default(0)
  createdAt DateTime                @default(now()) @db.Timestamptz
  updatedAt DateTime                @updatedAt @db.Timestamptz

  company Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  lines   WalletCashVoucherLine[]

  @@unique([companyId, code])
  // Referenced by voucher-line composite FKs.
  @@unique([id, companyId])
  @@index([companyId, status, id])
}

// One row per company — atomic voucher-number allocation. nextVoucherNo is
// incremented under INSERT ... ON CONFLICT inside the voucher transaction,
// so numbering is unique and gapless even under concurrent PIs.
model WalletVoucherCounter {
  companyId     String @id @db.Uuid
  nextVoucherNo BigInt @default(1)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
}

// Sarjan cash voucher — printable evidence of an outgoing wallet expense.
// 1:1 with the expense it documents; the posted ledger entry stays
// authoritative — voucher ops never touch WalletLedgerEntry.
model WalletCashVoucher {
  id                    String    @id @default(uuid()) @db.Uuid
  companyId             String    @db.Uuid
  voucherNo             BigInt // company-scoped, unique, never reused
  expenseId             String    @db.Uuid
  walletId              String    @db.Uuid
  siteId                String    @db.Uuid
  date                  DateTime  @db.Date
  paidTo                String?   @db.VarChar(200) // receiver name — NOT a signature
  narration             String?   @db.VarChar(500) // audit only — never in notifications
  currency              String    @db.VarChar(3) // must equal expense.currency (INR)
  preparedByPrincipalId String    @db.Uuid // authenticated PI — server-set
  preparedByEmployeeId  String    @db.Uuid
  checkedByPrincipalId  String?   @db.Uuid // only set by a real authorization act
  checkedByEmployeeId   String?   @db.Uuid
  signedDocumentId      String?   @db.Uuid // uploaded receiver-signed copy
  signedAt              DateTime? @db.Timestamptz
  version               Int       @default(0)
  createdAt             DateTime  @default(now()) @db.Timestamptz
  updatedAt             DateTime  @updatedAt @db.Timestamptz

  company            Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  expense            WalletExpense           @relation(fields: [expenseId, companyId], references: [id, companyId], onDelete: Restrict)
  wallet             SiteWallet              @relation(fields: [walletId, companyId], references: [id, companyId], onDelete: Restrict)
  site               Site                    @relation(fields: [siteId, companyId], references: [id, companyId], onDelete: Restrict)
  preparedBy         Principal               @relation("WalletVoucherPreparer", fields: [preparedByPrincipalId], references: [id], onDelete: Restrict)
  preparedByEmployee Employee                @relation("WalletVoucherPreparerEmp", fields: [preparedByEmployeeId, companyId], references: [id, companyId], onDelete: Restrict)
  checkedBy          Principal?              @relation("WalletVoucherChecker", fields: [checkedByPrincipalId], references: [id], onDelete: Restrict)
  checkedByEmployee  Employee?               @relation("WalletVoucherCheckerEmp", fields: [checkedByEmployeeId, companyId], references: [id, companyId], onDelete: Restrict)
  signedDocument     Document?               @relation(fields: [signedDocumentId, companyId], references: [id, companyId], onDelete: Restrict)
  lines              WalletCashVoucherLine[]
  documentLinks      DocumentLink[]

  // Voucher numbers are company-scoped, unique, never reused.
  @@unique([companyId, voucherNo])
  // One voucher per expense in v1.
  @@unique([expenseId, companyId])
  // Referenced by line/document composite FKs.
  @@unique([id, companyId])
  @@index([companyId, siteId, id])
}

// Detail row of the printed form — account code/head are SNAPSHOTS of the
// catalog at post time so later account-head edits never rewrite history.
model WalletCashVoucherLine {
  id              String  @id @default(uuid()) @db.Uuid
  companyId       String  @db.Uuid
  voucherId       String  @db.Uuid
  lineNo          Int
  accountHeadId   String  @db.Uuid
  accountCode     String  @db.VarChar(20) // snapshot
  accountHeadName String  @db.VarChar(120) // snapshot
  amount          Decimal @db.Decimal(18, 2) // CHECK > 0; Σ lines == voucher expense amount

  company     Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  voucher     WalletCashVoucher @relation(fields: [voucherId, companyId], references: [id, companyId], onDelete: Restrict)
  accountHead WalletAccountHead @relation(fields: [accountHeadId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([voucherId, lineNo])
  @@unique([id, companyId])
}

// PI asks Finance to reverse a posted ledger entry. Finance executes the
// full reversal (or rejects with a reason). At most one open request per
// ledger entry — enforced by a partial unique index in the migration.
model WalletReversalRequest {
  id                     String                      @id @default(uuid()) @db.Uuid
  companyId              String                      @db.Uuid
  walletId               String                      @db.Uuid
  siteId                 String                      @db.Uuid
  ledgerEntryId          String                      @db.Uuid // entry to reverse
  reason                 String                      @db.VarChar(500)
  status                 WalletReversalRequestStatus @default(REQUESTED)
  requestedByPrincipalId String                      @db.Uuid
  requestedByEmployeeId  String                      @db.Uuid
  decidedByPrincipalId   String?                     @db.Uuid
  decidedAt              DateTime?                   @db.Timestamptz
  decisionReason         String?                     @db.VarChar(500)
  reversalEntryId        String?                     @db.Uuid // resulting REVERSAL_* entry
  idempotencyKey         String                      @db.VarChar(80)
  version                Int                         @default(0)
  createdAt              DateTime                    @default(now()) @db.Timestamptz
  updatedAt              DateTime                    @updatedAt @db.Timestamptz

  company             Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  wallet              SiteWallet         @relation(fields: [walletId, companyId], references: [id, companyId], onDelete: Restrict)
  site                Site               @relation(fields: [siteId, companyId], references: [id, companyId], onDelete: Restrict)
  ledgerEntry         WalletLedgerEntry  @relation("WalletReversalTarget", fields: [ledgerEntryId, companyId], references: [id, companyId], onDelete: Restrict)
  reversalEntry       WalletLedgerEntry? @relation("WalletReversalResult", fields: [reversalEntryId, companyId], references: [id, companyId], onDelete: Restrict)
  requestedBy         Principal          @relation("WalletReversalRequester", fields: [requestedByPrincipalId], references: [id], onDelete: Restrict)
  requestedByEmployee Employee           @relation("WalletReversalReqEmp", fields: [requestedByEmployeeId, companyId], references: [id, companyId], onDelete: Restrict)
  decidedBy           Principal?         @relation("WalletReversalDecider", fields: [decidedByPrincipalId], references: [id], onDelete: Restrict)

  @@unique([id, companyId])
  // Retry-safe: one reversal request per (requester, idempotencyKey).
  @@unique([companyId, requestedByPrincipalId, idempotencyKey])
  @@index([companyId, status, id])
  @@index([companyId, walletId, status])
}
