# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# PostgreSQL (matches docker-compose.yml local dev values)
DATABASE_URL=postgresql://erp_dev:erp_dev_password@localhost:5432/erp_dev?schema=public

# Redis (matches docker-compose.yml local dev values)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Auth — replace with a random >=32-char secret (e.g. openssl rand -hex 32)
JWT_SECRET=change-me
JWT_ISSUER=sarjan-erp
JWT_AUDIENCE=sarjan-erp-api
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_S=1209600
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000

# Frontend / claim links — APP_BASE_URL is the trusted fallback origin for
# emailed claim URLs. CLAIM_URL_ORIGINS is an optional comma-separated
# allowlist; a request Origin/x-frontend-url is honoured ONLY on exact
# match against this list. HTTPS is enforced for claim links in production.
# APP_BASE_URL=https://app.example.com
# CLAIM_URL_ORIGINS=https://app.example.com,https://erp.example.com

# Mail Server (imaker.in)
SMTP_HOST=imaker.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@imaker.in
SMTP_PASS=your-email-password-here
MAIL_FROM_NAME="Sarjan Construction ERP"
MAIL_FROM_EMAIL=info@imaker.in
